<?xml version="1.0" encoding="UTF-8"?>

<project name="project" default="package" basedir="."
	xmlns:artifact="antlib:org.apache.maven.artifact.ant">

	<taskdef resource="net/sf/antcontrib/antcontrib.properties" />
	<typedef resource="org/apache/maven/artifact/ant/antlib.xml"
		uri="antlib:org.apache.maven.artifact.ant" />

	<propertyregex property="resources.dir" input="${project.build.sourceDirectory}"
			regexp="(.*)(java)" replace="\1resources" />
    
	<!-- ./target/../Icons -->
	<property name="icons.dir" value="${resources.dir}/Icons" />
	<!-- ./target/../License -->
	<property name="license.dir" value="${resources.dir}/License" />
	<!-- deployment dir for packagings -->
		<property name="deployment.root.folder" value="~/downloads/Formose" />

	<import>
		<javaresource name="build-packaging.xml">
			<classpath>
				<pathelement location="${org.openflexo:packaging-tools:jar}"></pathelement>
			</classpath>
		</javaresource>
	</import>

	<target name="package" depends="defineProperties">
		<delete dir="${mac.app.dir}" failonerror="false" />
		<mkdir dir="${mac.app.dir}" />
		<loadproperties srcfile="packaging.properties" />
		<antcall target="createPackage" />
	</target>


	<!-- launch4j 3.12 goes through XStream, which reflects into java.util / java.lang. Since Java 9
	     those packages are not open, so the nested Maven fails with "module java.base does not
	     open java.util" and NO .exe is produced. The generic macro of packaging-tools forks that
	     Maven with -Xmx512m only, and inherits neither MAVEN_OPTS nor any module opening, so this
	     target replaces it with the same invocation plus the required openings. -->
	<target name="generateFlexoLauncher">
		<copy tofile="${flexobuild.work.dir}/pom.xml" filtering="true" failonerror="true"
			overwrite="true">
			<resources>
				<javaresource name="Windows/pom_launch4j.xml.tpl">
					<classpath>
						<pathelement location="${org.openflexo:packaging-tools:jar}"></pathelement>
					</classpath>
				</javaresource>
			</resources>
			<filterset>
				<filtersfile file="${build.properties}" />
			</filterset>
		</copy>
		<!-- Formod, built on OpenFlexo 2.99, only runs on Java 8: PAMELA proxies fail on any later Java. The template
		     only sets a minimum version (1.7.0), so the launcher picked the most recent Java installed,
		     and the application froze at startup. Bound the version on both sides, for the GUI and the
		     console launchers. If no Java 8 is found, launch4j stops with an explicit message. -->
		<replace file="${flexobuild.work.dir}/pom.xml" summary="true" failOnNoReplacements="true">
			<replacetoken><![CDATA[<minVersion>1.7.0</minVersion>]]></replacetoken>
			<replacevalue><![CDATA[<minVersion>1.8.0</minVersion><maxVersion>1.8.0_999</maxVersion>]]></replacevalue>
		</replace>
		<!-- Make the failure explicit: the template pointed users to java.com, which offers the most recent
		     Java, the very one this release cannot run on. Point to a Java 8 runtime instead, and say why. -->
		<replace file="${flexobuild.work.dir}/pom.xml" summary="true" failOnNoReplacements="true">
			<replacetoken><![CDATA[<downloadUrl>http://java.com/download</downloadUrl>]]></replacetoken>
			<replacevalue><![CDATA[<downloadUrl>https://adoptium.net/temurin/releases/?version=8&amp;os=windows&amp;arch=x64&amp;package=jre</downloadUrl>]]></replacevalue>
		</replace>
		<replace file="${flexobuild.work.dir}/pom.xml" summary="true" failOnNoReplacements="true">
			<replacetoken><![CDATA[<errTitle>Openflexo - Application Error</errTitle>]]></replacetoken>
			<replacevalue><![CDATA[<errTitle>Formod - Application Error</errTitle><messages><jreVersionErr>This version of Formod requires Java 8 (version 1.8), and no Java 8 was found on this computer. More recent Java versions are not supported by this release. Please install a Java 8 runtime.</jreVersionErr></messages>]]></replacevalue>
		</replace>
		<java classname="org.codehaus.classworlds.Launcher" fork="true"
			dir="${flexobuild.work.dir}" resultproperty="maven.build.result" failonerror="true">
			<jvmarg value="-Xmx512m" />
			<jvmarg value="--add-opens" /><jvmarg value="java.base/java.util=ALL-UNNAMED" />
			<jvmarg value="--add-opens" /><jvmarg value="java.base/java.lang=ALL-UNNAMED" />
			<jvmarg value="--add-opens" /><jvmarg value="java.base/java.lang.reflect=ALL-UNNAMED" />
			<jvmarg value="--add-opens" /><jvmarg value="java.base/java.text=ALL-UNNAMED" />
			<jvmarg value="--add-opens" /><jvmarg value="java.desktop/java.awt.font=ALL-UNNAMED" />
			<classpath>
				<fileset dir="${maven.home}/boot">
					<include name="*.jar" />
				</fileset>
				<fileset dir="${maven.home}/lib">
					<include name="*.jar" />
				</fileset>
			</classpath>
			<sysproperty key="classworlds.conf" value="${maven.home}/bin/m2.conf" />
			<sysproperty key="maven.home" value="${maven.home}" />
			<sysproperty key="maven.repo.local" value="${maven.repo.local}" />
			<sysproperty key="maven.multiModuleProjectDirectory" value="false" />
			<arg line="--batch-mode package" />
		</java>
	</target>

</project>