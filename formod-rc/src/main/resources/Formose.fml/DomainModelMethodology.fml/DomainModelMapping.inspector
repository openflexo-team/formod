<?xml version="1.0" encoding="UTF-8"?>
<!-- Inspector of DomainModelMapping, rebuilt from the Inspector of its legacy .fml.xml serialization. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="DomainModelMappingInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FlexoConceptInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<TabPanel name="Tab">
		<Tab title="DomainModel" layout="twocols" index="0" name="DomainModelMappingInspectorTab">
			<Label label="modelName" name="modelNameLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left)" />
			<TextField data="data.domainModel.modelName" name="modelNameTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right)" />
		</Tab>
	</TabPanel>
</Panel>
