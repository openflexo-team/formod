			/** Rule 17: a variable concept is initialised with the enumeration of its constant individuals */
			public concept Concept2Initialisation extends StructuralRuleMapping {

				Concept domainConcept with ConceptInstance(virtualModelInstance=container.domainModel);
				String individualsString;
				BSubstitution substitution with BSubstitutionRole();

				create(Concept aConcept, String individualsString) {
					log "Concept2Initialisation: create Initialisation substitution related to concept " + parameters.aConcept;
					domainConcept = parameters.aConcept;
					individualsString = parameters.individualsString;
					BExpression left = B::CreateBExpressionFromString(expressionAsString=domainConcept.name)
							in (container.machine.componentResource.bComponent);
					BExpression right = B::CreateBExpressionFromString(expressionAsString=individualsString)
							in (container.machine.componentResource.bComponent);
					substitution = B::CreateBSubstitution(operator="AssignSubstitution", leftOperand=left, rightOperand=right)
							in (container.machine.componentResource.bComponent);
					log "substitution " + substitution.getNormalizedBRepresentation();
					container.initialisationOperationBody.addToSubstitutions(substitution);
				}

				delete::deleteWithBItem() {
					container.initialisationOperationBody.removeFromSubstitutions(substitution);
					delete substitution;
				}
			}

			/** Rule 16: a variable individual is initialised with its initial value, or with any element of its concept */
			public concept Individual2Initialisation extends StructuralRuleMapping {

				Individual individual with ConceptInstance(virtualModelInstance=container.domainModel);
				BSubstitution substitution with BSubstitutionRole();

				create(Individual anIndividual) {
					log "Individual2Initialisation: create Initialisation substitution related to individual " + parameters.anIndividual;
					individual = parameters.anIndividual;
					BExpression left = B::CreateBExpressionFromString(expressionAsString=individual.name)
							in (container.machine.componentResource.bComponent);
					if (individual.initialValue != null) {
						String rightString = "";
						if (individual.initialValue.name != null) {
							rightString = individual.initialValue.name;
						}
						else {
							rightString = individual.getCanonicalString();
						}
						BExpression right = B::CreateBExpressionFromString(expressionAsString=rightString)
								in (container.machine.componentResource.bComponent);
						substitution = B::CreateBSubstitution(operator="AssignSubstitution", leftOperand=left, rightOperand=right)
								in (container.machine.componentResource.bComponent);
					}
					else {
						BExpression right = B::CreateBExpressionFromString(expressionAsString=individual.individualOf.name)
								in (container.machine.componentResource.bComponent);
						substitution = B::CreateBSubstitution(operator="BecomeElementOfSubstitution", leftOperand=left, rightOperand=right)
								in (container.machine.componentResource.bComponent);
					}
					log "substitution " + substitution.getNormalizedBRepresentation();
					container.initialisationOperationBody.addToSubstitutions(substitution);
				}

				delete::deleteWithBItem() {
					container.initialisationOperationBody.removeFromSubstitutions(substitution);
					delete substitution;
				}
			}

			/** Rule 15: an unnamed variable maplet is initialised with its antecedent |-> image */
			public concept UnnamedMapletIndividual2Initialisation extends StructuralRuleMapping {

				MapletIndividual individual with ConceptInstance(virtualModelInstance=container.domainModel);
				BSubstitution substitution with BSubstitutionRole();

				create(MapletIndividual anIndividual) {
					log "UnnamedMapletIndividual2Initialisation: create Initialisation substitution related to UnnamedMapletIndividual "
							+ parameters.anIndividual;
					individual = parameters.anIndividual;
					BExpression left = B::CreateBExpressionFromString(expressionAsString=individual.getNormalisedString())
							in (container.machine.componentResource.bComponent);
					BExpression right = B::CreateBExpressionFromString(
							expressionAsString=individual.antecedent.name + " |-> " + individual.image.name)
							in (container.machine.componentResource.bComponent);
					substitution = B::CreateBSubstitution(operator="AssignSubstitution", leftOperand=left, rightOperand=right)
							in (container.machine.componentResource.bComponent);
					log "substitution " + substitution.getNormalizedBRepresentation();
					container.initialisationOperationBody.addToSubstitutions(substitution);
				}

				delete::deleteWithBItem() {
					container.initialisationOperationBody.removeFromSubstitutions(substitution);
					delete substitution;
				}
			}

