			}

			/** Rules 11 to 15: an invariant of the machine stating a fact about a variable individual */
			public concept Individual2Invariant extends StructuralRuleMapping {

				Individual individual with ConceptInstance(virtualModelInstance=container.domainModel);
				BPredicate typingPredicate with BPredicateRole();
				String formula;

				create(Individual anIndividual, String formula) {
					log "Individual2Invariant: create Invariant " + parameters.formula + " related to individual " + parameters.anIndividual;
					individual = parameters.anIndividual;
