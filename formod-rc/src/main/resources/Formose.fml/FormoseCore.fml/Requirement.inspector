<?xml version="1.0" encoding="UTF-8"?>
<!-- Inspector of Requirement, rebuilt from the Inspector of its legacy .fml.xml serialization. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="RequirementInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FlexoConceptInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<TabPanel name="Tab">
		<Tab title="Requirement" layout="twocols" index="0" name="RequirementInspectorTab">
			<Label label="name" name="nameLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=1)" />
			<TextField data="data.name" name="nameTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=1)" />
			<Label label="description" name="descriptionLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=2)" />
			<TextArea data="data.description" validateOnReturn="true" useScrollBar="true" name="descriptionTextArea" constraints="twocols(expandHorizontally=true;expandVertically=true;location=right;index=2)" />
			<Label label="status" name="statusLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=3)" />
			<TextField data="data.status" readOnly="true" name="statusTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=3)" />
		</Tab>
	</TabPanel>
</Panel>
