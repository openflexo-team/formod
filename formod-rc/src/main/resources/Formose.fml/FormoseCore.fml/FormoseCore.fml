/**
 * Core model of a Formose project: a tree of elements, each of which holds requirements.
 *
 * Migrated from the legacy FormoseCore.fml.xml serialization (formod 2.1).
 *
 * Deliberate divergences from the legacy model, all of them repairs:
 * - Element.parent was declared with cardinality One while the project element has none (and the legacy creation scheme never set
 *   it), so it is optional here;
 * - the legacy model carried one nameless, empty FlexoConcept, dropped;
 * - inspectors are gone: FlexoConceptInspector is deprecated in 2.99.
 *
 * Not migrated yet, and deliberately absent until the VirtualModel they need exists:
 * - ui, the gina-ta driven user interface of Element (Fib/ElementUI.fib), which moves to the container-based user interface;
 * - applicableSysMLKaosMethodology / createSysMLKaosMethodology (SysML/KAOS phase);
 * - applicableDomainModelMethodology / createDomainModelMethodology (domain model phase);
 * - applicableBMethodology / createBMethodology (B phase).
 *
 * @version 0.1
 */

use org.openflexo.foundation.fml.rt.FMLRTModelSlot as FMLRT;

import java.util.List;

@URI("http://formose.lacl.fr/Formose.fml/FormoseCore.fml")
@Version("0.1")
public model FormoseCore {

	/** The element representing the project itself, root of the element tree */
	Element projectElement with ConceptInstance();

	public List<Element> allElements() {
		return select Element from this;
	}

	create::init(String projectName) {
		projectElement = new Element::createElement("Project");
		notify "projectElement" in this;
	}

	delete() {
	}

	public Element addElement() {
		return new Element::createElement("elementTODO");
	}

	public removeElement(Element element) {
		delete parameters.element;
	}

	@Renderer("identifier")
	public concept Element {

		String[1,1] identifier;
		String description;

		/** Parent element in the element tree, null for the project element */
		Element parent with ConceptInstance(virtualModelInstance=container);

		Element[0,*] childrenElements with ConceptInstance(virtualModelInstance=container);

		public List<Requirement> requirements() {
			return select Requirement from this;
		}

		create::createElement(String elementIdentifier) {
			identifier = parameters.elementIdentifier;
		}

		delete() {
		}

		public Element createChildrenElement(String elementIdentifier, String elementDescription) {
			log "Creating new element " + parameters.elementIdentifier;
			Element newElement = container.new Element::createElement(parameters.elementIdentifier);
			newElement.description = parameters.elementDescription;
			newElement.parent = this;
			childrenElements.add(newElement);
			fire new NewElement(newElement);
			return newElement;
		}

		public Requirement createRequirement(String name, String description) {
			log "Creating new requirement " + parameters.name;
			Requirement newRequirement = new Requirement::createRequirement(parameters.name, parameters.description);
			notify "requirements" in this;
			fire new NewRequirement(newRequirement);
			return newRequirement;
		}

		public Requirement createRequirementNoNotification(String name, String description) {
			Requirement newRequirement = new Requirement::createRequirement(parameters.name, parameters.description);
			notify "requirements" in this;
			return newRequirement;
		}

		public concept Requirement {

			String[1,1] name;
			String description;

			/** Proved correct, not correct / Not proved / Not to prove / To prove / Represented or not */
			String[1,1] status;

			create::createRequirement(String name, String description) {
				name = parameters.name;
				description = parameters.description;
				notify "requirements" in container;
			}

			delete() {
				notify "requirements" in container;
			}
		}
	}

	event NewElement {
		Element element with ConceptInstance(virtualModelInstance=container);
		create(Element anElement) {
			element = parameters.anElement;
		}
	}

	event NewRequirement {
		Requirement requirement;
		create(Requirement aRequirement) {
			requirement = parameters.aRequirement;
		}
	}
}
