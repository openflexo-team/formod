/**
 * Base of every Formose methodology (SysML/KAOS, domain model, B, document annotation): a methodology is declared on an element of
 * the Formose core model, and applies to this element and to its descendants.
 *
 * Migrated from the legacy Methodology.fml.xml serialization (formod 2.1).
 *
 * @version 0.1
 */

import ["http://formose.lacl.fr/Formose.fml/FormoseCore.fml"];

@URI("http://formose.lacl.fr/Formose.fml/Methodology.fml")
@Version("0.1")
public abstract model Methodology {

	String[1,1] name;

	/** Element in which this methodology has been declared */
	Element declaringElement with ConceptInstance(virtualModelInstance=container.formoseVMI);

	public abstract concept Transition {

		String[1,1] user;

		/** Date when the transition was initiated by a user */
		String timestamp;

		/** Justification of the transition */
		String comments;

		create() {
		}

		delete() {
		}
	}
}
