/**
 * A SysML/KAOS goal model: goals (functional, non-functional, contribution), the refinements relating them, the agents made
 * responsible for them, and the groups gathering them. A model may refine another one through parentModel.
 *
 * Migrated from the legacy SysMLKaosModel.fml.xml serialization (formod 2.1).
 *
 * Deliberate divergences from the legacy model, all of them repairs:
 * - NewGoalGroup.group was declared a String while the event assigns a GoalGroup instance to it: it is now a GoalGroup;
 * - GoalGroup.create assigned its "goals" list in one go, which FML does not support for a multiple-cardinality role (the role is
 *   filled one instance at a time), so the goals are added in a loop;
 * - addFunctionalGoal / addRefinement created their instance in "rootModel", a property of the containing SysMLKaos model and not of
 *   this one: they now create it in this model, which is what the containing model's rootModel designates anyway;
 * - Goal.parentGoal iterated a variable named after the property it computes, shadowing it: the iterator is now named goal;
 * - inspectors are gone: FlexoConceptInspector is deprecated in 2.99; the icons they declared follow in the user interface step.
 *
 * @version 0.1
 */

use org.openflexo.foundation.fml.rt.FMLRTModelSlot as FMLRT;

import java.util.List;

@URI("http://formose.lacl.fr/SysMLKaos/SysMLKaos.fml/SysMLKaosModel.fml")
@Version("0.1")
public model SysMLKaosModel {

	String modelName;
	String modelTitle;
	String modelDescription;

	/** The model this one refines, when it is not the root model */
	SysMLKaosModel parentModel with ModelInstance();

	public List<Goal> goals() {
		return select Goal from this;
	}

	public List<Agent> agents() {
		return select Agent from this;
	}

	public List<GoalGroup> groups() {
		return select GoalGroup from this;
	}

	/** Goals no group gathers */
	public List<Goal> ungroupedGoals() {
		return select Goal from this where (selected.goalGroup == null);
	}

	/** Groups no other group contains */
	public List<GoalGroup> topLevelGroups() {
		return select GoalGroup from this where (selected.parentGroup == null);
	}

	create::init(String name, String title, String description, SysMLKaosModel parentModel) {
		modelName = parameters.name;
		modelTitle = parameters.title;
		modelDescription = parameters.description;
		parentModel = parameters.parentModel;
	}

	delete() {
	}

	public FunctionalGoal addFunctionalGoal(String name, String type, String description) {
		return new FunctionalGoal(parameters.name, parameters.type, parameters.description, true);
	}

	public Refinement addRefinement() {
		return new Refinement();
	}

	public removeRefinement(Refinement refinement) {
		delete parameters.refinement;
	}

	/**
	 * An abstract goal, functional or not, achieved by one of its refinements
	 */
	@Renderer("name")
	public abstract concept Goal {

		String name;
		String description;

		Refinement[0,*] parentRefinement with ConceptInstance(virtualModelInstance=container);
		Refinement[0,*] childrenRefinement with ConceptInstance(virtualModelInstance=container);
		GoalGroup goalGroup with ConceptInstance(virtualModelInstance=container);

		/** First goal this one refines, null when it refines none */
		Goal parentGoal {
			Goal get() {
				for (Refinement refinement : parentRefinement) {
					for (Goal goal : refinement.parentGoal) {
						return goal;
					}
				}
				return null;
			}
		};

		/** First refinement this goal takes part in, as a child */
		Refinement refines {
			Refinement get() {
				for (Refinement refinement : parentRefinement) {
					return refinement;
				}
				return null;
			}
		};

		public createGoal(String name, String description) {
			name = parameters.name;
			description = parameters.description;
		}

		public delete() {
			SysMLKaosModel containerModel = container;
			for (Refinement item : parentRefinement) {
				item.childGoals.remove(this);
			}
			for (Refinement item : childrenRefinement) {
				item.parentGoal.remove(this);
			}
			delete this;
			fire new DeletedGoal(this);
			notify "goals" in containerModel;
		}
	}

	/**
	 * A functional goal: a plain goal to be refined while no responsibility is defined, an expectation once an environmental agent
	 * is made responsible for it, a requirement once a software agent is
	 */
	@Renderer("name")
	public concept FunctionalGoal extends Goal {

		/** Responsibility is used when there is only one agent responsible for the goal */
		Agent[0,*] responsability with ConceptInstance(virtualModelInstance=container);

		/** Assignment is used when several agents may be made responsible for the goal */
		Agent[0,*] assignments with ConceptInstance(virtualModelInstance=container);

		String functionalGoalType;

		// The legacy parameter was named "notify", which is an FML keyword: parameters.notify silently parsed as parameters.null
		create(String name, String type, String description, boolean shouldNotify) {
			functionalGoalType = parameters.type;
			this.createGoal(parameters.name, parameters.description);
			if (parameters.shouldNotify) {
				log "Notify new event";
				fire new NewGoal(this);
			}
			notify "ungroupedGoals" in container;
		}
	}

	/**
	 * A non functional goal: a plain goal to be refined while no contribution is defined, an elementary non functional goal once at
	 * least one contribution is
	 */
	@Renderer("name")
	public concept NonFunctionalGoal extends Goal {

		String nonFunctionalGoalType;
		String topic;

		Contribution[1,*] contributions with ConceptInstance(virtualModelInstance=container);

		create(String name, String type, String description) {
			this.createGoal(parameters.name, parameters.description);
			nonFunctionalGoalType = parameters.type;
			fire new NewGoal(this);
			notify "ungroupedGoals" in container;
		}
	}

	/** A goal contributing to non functional goals */
	@Renderer("name")
	public concept ContributionGoal extends Goal {

		String contributionGoalType;

		create(String name, String type, String description) {
			this.createGoal(parameters.name, parameters.description);
			contributionGoalType = parameters.type;
			fire new NewGoal(this);
			notify "ungroupedGoals" in container;
		}
	}

	/**
	 * A refinement relationship between a goal and a collection of goals; its semantics (and, or, milestone, data) is carried by the
	 * logical type
	 */
	public concept Refinement {

		/** The goals being refined */
		Goal[0,*] parentGoal with ConceptInstance(virtualModelInstance=container);

		/** The goals that define the refinement */
		Goal[0,*] childGoals with ConceptInstance(virtualModelInstance=container);

		boolean isAnd;
		boolean isOr;
		boolean isMilestone;
		boolean isData;

		String refinementType {
			String get() {
				if (isAnd) {
					return "ref_and";
				}
				if (isOr) {
					return "ref_or";
				}
				if (isMilestone) {
					return "ref_milestone";
				}
				return "ref";
			}
		};

		create() {
			this.setLogicalTypeToAnd();
		}

		create::createLink(Goal parentGoal, Goal childrenGoal) {
			parentGoal.add(parameters.parentGoal);
			childGoals.add(parameters.childrenGoal);
			parameters.parentGoal.childrenRefinement.add(this);
			parameters.childrenGoal.parentRefinement.add(this);
			this.setLogicalTypeToAnd();
		}

		delete() {
			this.removeAllLinksToParentGoal();
			this.removeAllLinksToChildGoals();
		}

		public addLinkToAParentGoal(Goal parentGoal) {
			if (!parentGoal.contains(parameters.parentGoal)) {
				parentGoal.add(parameters.parentGoal);
				parameters.parentGoal.childrenRefinement.add(this);
			}
		}

		public addLinkToAChildrenGoal(Goal childrenGoal) {
			if (!childGoals.contains(parameters.childrenGoal)) {
				childGoals.add(parameters.childrenGoal);
				parameters.childrenGoal.parentRefinement.add(this);
			}
		}

		public removeLinkToAParentGoal(Goal parentGoal) {
			parameters.parentGoal.childrenRefinement.remove(this);
			parentGoal.remove(parameters.parentGoal);
		}

		public removeLinkToAChildrenGoal(Goal childrenGoal) {
			log "Behaviour removeLinkToAChildrenGoal";
			parameters.childrenGoal.parentRefinement.remove(this);
			childGoals.remove(parameters.childrenGoal);
		}

		public removeAllLinksToParentGoal() {
			for (Goal item : parentGoal) {
				this.removeLinkToAParentGoal(item);
			}
		}

		public removeAllLinksToChildGoals() {
			for (Goal item : childGoals) {
				this.removeLinkToAChildrenGoal(item);
			}
		}

		public setLogicalTypeToAnd() {
			isOr = false;
			isAnd = true;
			isMilestone = false;
			isData = false;
		}

		public setLogicalTypeToOr() {
			isAnd = false;
			isOr = true;
			isMilestone = false;
			isData = false;
		}

		public setLogicalTypeToNone() {
			isAnd = false;
			isOr = false;
			isData = false;
			isMilestone = false;
		}

		public setLogicalTypeToMilestone() {
			isAnd = false;
			isOr = false;
			isData = false;
			isMilestone = true;
		}

		public setLogicalTypeToData() {
			isAnd = false;
			isOr = false;
			isData = true;
			isMilestone = false;
		}
	}

	/** An agent of the modelled system or of its environment */
	public abstract concept Agent {

		String name;
		String description;

		public createAgent(String name, String description) {
			name = parameters.name;
			description = parameters.description;
		}

		public delete() {
			SysMLKaosModel containerModel = container;
			delete this;
			fire new DeletedAgent(this);
			notify "agents" in containerModel;
		}
	}

	@Renderer("name")
	public concept EnvironmentalAgent extends Agent {

		create::createEnvironmentalAgent(String name, String description) {
			this.createAgent(parameters.name, parameters.description);
			notify "agents" in container;
		}
	}

	@Renderer("name")
	public concept SoftwareAgent extends Agent {

		create::createSoftwareAgent(String name, String description) {
			this.createAgent(parameters.name, parameters.description);
			notify "agents" in container;
		}
	}

	/** Assigns an agent to a goal */
	public concept AgentAssignment {

		Agent agent with ConceptInstance(virtualModelInstance=container);
		Goal goal with ConceptInstance(virtualModelInstance=container);

		create(Agent anAgent, Goal aGoal) {
			agent = parameters.anAgent;
			goal = parameters.aGoal;
		}

		delete() {
			agent = null;
			goal = null;
		}
	}

	/** Contribution of a contribution goal to a non functional goal */
	public concept Contribution {

		ContributionGoal contributionGoal with ConceptInstance(virtualModelInstance=container);
		NonFunctionalGoal nonFunctionalGoal with ConceptInstance(virtualModelInstance=container);
		boolean isPositive;
		String description;

		create(ContributionGoal contributionGoal, NonFunctionalGoal nonFunctionalGoal, boolean isPositive) {
			contributionGoal = parameters.contributionGoal;
			nonFunctionalGoal = parameters.nonFunctionalGoal;
			isPositive = parameters.isPositive;
		}

		delete() {
		}
	}

	/** Impact of a contribution goal on a functional goal */
	public concept Impact {

		ContributionGoal contributionGoal with ConceptInstance(virtualModelInstance=container);
		FunctionalGoal functionalGoal with ConceptInstance(virtualModelInstance=container);
		boolean isPositive;
		String description;

		create(ContributionGoal contributionGoal, FunctionalGoal functionalGoal, boolean isPositive) {
			contributionGoal = parameters.contributionGoal;
			functionalGoal = parameters.functionalGoal;
			isPositive = parameters.isPositive;
		}

		delete() {
		}
	}

	/** A group of goals, itself possibly contained in the group of their parent goals */
	@Renderer("title")
	public concept GoalGroup {

		Goal[0,*] goals with ConceptInstance(virtualModelInstance=container);
		String title;

		/** Group of the parent goal of one of our goals */
		GoalGroup parentGroup {
			GoalGroup get() {
				for (Goal goal : goals) {
					if (goal.parentGoal != null) {
						if (goal.parentGoal.goalGroup != null) {
							return goal.parentGoal.goalGroup;
						}
					}
				}
				return null;
			}
		};

		public List<GoalGroup> childrenGroups() {
			return select GoalGroup from container where (selected.parentGroup == this);
		}

		create(String title, List<Goal> goals) {
			title = parameters.title;
			for (Goal goal : parameters.goals) {
				goals.add(goal);
			}
			fire new NewGoalGroup(this);
			notify "groups" in container;
			notify "ungroupedGoals" in container;
		}

		delete() {
		}
	}

	event NewGoal {
		Goal goal;
		create(Goal aGoal) {
			goal = parameters.aGoal;
		}
	}

	event DeletedGoal {
		Goal goal;
		create(Goal aGoal) {
			goal = parameters.aGoal;
		}
	}

	event DeletedAgent {
		Agent agent;
		create(Agent anAgent) {
			agent = parameters.anAgent;
		}
	}

	event NewGoalGroup {
		GoalGroup group;
		create(GoalGroup aGroup) {
			group = parameters.aGroup;
		}
	}
}
