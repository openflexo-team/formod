<?xml version="1.0" encoding="UTF-8"?>
<!-- Inspector of Agent, rebuilt from the Inspector of its legacy .fml.xml serialization. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="AgentInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FlexoConceptInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<TabPanel name="Tab">
		<Tab title="Agent" layout="twocols" index="0" name="AgentInspectorTab">
			<Label label="agentName" name="agentNameLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left)" />
			<TextField data="data.name" name="agentNameTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right)" />
			<Label label="description" name="descriptionLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left)" />
			<TextArea data="data.description" validateOnReturn="true" useScrollBar="true" name="descriptionTextArea" constraints="twocols(expandHorizontally=true;expandVertically=true;location=right)" />
		</Tab>
	</TabPanel>
</Panel>
