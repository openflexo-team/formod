<?xml version="1.0" encoding="UTF-8"?>
<!-- Inspector of SysMLKaosModel, rebuilt from the Inspector of its legacy .fml.xml serialization. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="SysMLKaosModelInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FMLRTVirtualModelInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<Label label="modelTitle" name="modelTitleLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=1)" />
	<TextField data="data.modelTitle" name="modelTitleTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=1)" />
	<Label label="modelDescription" name="modelDescriptionLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=2)" />
	<TextArea data="data.modelDescription" validateOnReturn="true" useScrollBar="true" name="modelDescriptionTextArea" constraints="twocols(expandHorizontally=true;expandVertically=true;location=right;index=2)" />
</Panel>
