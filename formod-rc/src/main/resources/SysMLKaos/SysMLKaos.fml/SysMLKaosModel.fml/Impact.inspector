<?xml version="1.0" encoding="UTF-8"?>
<!-- Inspector of Impact. The entries were those of the inspector of ImpactGR, which now derives to this one. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="ImpactInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FlexoConceptInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<Label label="Contribution goal" name="contributionGoalLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=1)" />
	<TextField data="data.contributionGoal.name" name="contributionGoalTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=1)" />
	<Label label="Functional goal" name="functionalGoalLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=2)" />
	<TextField data="data.functionalGoal.name" readOnly="true" name="functionalGoalTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=2)" />
	<Label label="Contribution" name="contributionLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=3)" />
	<TextField data='(data.isPositive ? "Positive" : "Negative")' readOnly="true" name="contributionTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=3)" />
	<Label label="description" name="descriptionLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=4)" />
	<TextArea data="data.description" validateOnReturn="true" useScrollBar="true" name="descriptionTextArea" constraints="twocols(expandHorizontally=true;expandVertically=true;location=right;index=4)" />
</Panel>
