<?xml version="1.0" encoding="UTF-8"?>
<!-- Inspector of ContributionGoalGR, rebuilt from the Inspector of its legacy .fml.xml serialization. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="ContributionGoalGRInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FlexoConceptInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<TabPanel name="Tab">
		<Tab title="Contribution Goal" layout="twocols" index="0" name="ContributionGoalGRInspectorTab">
			<Label label="type" name="typeLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=101)" />
			<TextField data="data.goal.contributionGoalType" name="typeTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=101)" />
		</Tab>
	</TabPanel>
</Panel>
