<?xml version="1.0" encoding="UTF-8"?>
<!-- Inspector of AgentGR, rebuilt from the Inspector of its legacy .fml.xml serialization. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="AgentGRInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FlexoConceptInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<TabPanel name="Tab">
		<Tab title="Agent" layout="twocols" index="0" name="AgentGRInspectorTab">
			<Label label="Agent" name="agentLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left)" />
			<TextField data="data.agent.name" name="agentTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right)" />
			<Label label="Description" name="descriptionLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left)" />
			<TextArea data="data.agent.description" validateOnReturn="true" useScrollBar="true" name="descriptionTextArea" constraints="twocols(expandHorizontally=true;expandVertically=true;location=right)" />
		</Tab>
	</TabPanel>
</Panel>
