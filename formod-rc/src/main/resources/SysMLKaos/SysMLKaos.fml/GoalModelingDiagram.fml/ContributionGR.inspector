<?xml version="1.0" encoding="UTF-8"?>
<!-- Inspector of ContributionGR, rebuilt from the Inspector of its legacy .fml.xml serialization. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="ContributionGRInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FlexoConceptInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<TabPanel name="Tab">
		<Tab title="Contribution" layout="twocols" index="0" name="ContributionGRInspectorTab">
			<Label label="Contribution goal" name="contributionGoalLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=1)" />
			<TextField data="data.contribution.contributionGoal.name" name="contributionGoalTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=1)" />
			<Label label="Non Functional goal" name="nonFunctionalGoalLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=2)" />
			<TextField data="data.contribution.nonFunctionalGoal.name" readOnly="true" name="nonFunctionalGoalTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=2)" />
			<Label label="Contribution" name="contributionLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=3)" />
			<TextField data='(data.contribution.isPositive ? "Positive" : "Negative")' readOnly="true" name="contributionTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=3)" />
			<Label label="description" name="descriptionLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=4)" />
			<TextArea data="data.contribution.description" validateOnReturn="true" useScrollBar="true" name="descriptionTextArea" constraints="twocols(expandHorizontally=true;expandVertically=true;location=right;index=4)" />
		</Tab>
	</TabPanel>
</Panel>
