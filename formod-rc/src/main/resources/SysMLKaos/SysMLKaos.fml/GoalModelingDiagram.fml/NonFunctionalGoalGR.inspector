<?xml version="1.0" encoding="UTF-8"?>
<!-- Inspector of NonFunctionalGoalGR, rebuilt from the Inspector of its legacy .fml.xml serialization. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="NonFunctionalGoalGRInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FlexoConceptInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<TabPanel name="Tab">
		<Tab title="Non Functional Goal" layout="twocols" index="0" name="NonFunctionalGoalGRInspectorTab">
			<Label label="Type" name="typeLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left)" />
			<TextField data="data.goal.nonFunctionalGoalType" name="typeTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right)" />
			<Label label="Topic" name="topicLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left)" />
			<TextField data="data.goal.topic" name="topicTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right)" />
		</Tab>
	</TabPanel>
</Panel>
