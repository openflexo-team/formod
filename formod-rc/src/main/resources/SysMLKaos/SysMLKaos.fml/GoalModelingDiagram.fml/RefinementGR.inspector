<?xml version="1.0" encoding="UTF-8"?>
<!-- Inspector of RefinementGR, rebuilt from the Inspector of its legacy .fml.xml serialization. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="RefinementGRInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FlexoConceptInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<TabPanel name="Tab">
		<Tab title="Refinement" layout="twocols" index="0" name="RefinementGRInspectorTab">
			<Label label="Type" name="typeLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left)" />
			<TextField data='(data.refinement.isAnd ? "AND" : (data.refinement.isOr ? "OR" : (data.refinement.isMilestone ? "MLS" : (data.refinement.isData ? "DTA" : "NONE"))))' readOnly="true" name="typeTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right)" />
		</Tab>
	</TabPanel>
</Panel>
