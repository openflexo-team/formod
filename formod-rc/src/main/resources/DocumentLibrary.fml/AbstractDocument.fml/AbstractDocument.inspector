<?xml version="1.0" encoding="UTF-8"?>
<!-- Inspector of AbstractDocument, rebuilt from the Inspector of its legacy .fml.xml serialization. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="AbstractDocumentInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FMLRTVirtualModelInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<Label label="document_name" name="documentNameLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=1)" />
	<TextField data="data.documentName" name="documentNameTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=1)" />
	<Label label="document_description" name="documentDescriptionLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=2)" />
	<TextArea data="data.documentDescription" validateOnReturn="true" useScrollBar="true" name="documentDescriptionTextArea" constraints="twocols(expandHorizontally=true;expandVertically=true;location=right;index=2)" />
</Panel>
