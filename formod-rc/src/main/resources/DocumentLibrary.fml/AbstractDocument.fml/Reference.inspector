<?xml version="1.0" encoding="UTF-8"?>
<!-- Inspector of Reference, rebuilt from the Inspector of its legacy .fml.xml serialization. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="ReferenceInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FlexoConceptInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<Label label="document" name="documentLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=1)" />
	<TextField data="data.documentName" readOnly="true" name="documentTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=1)" />
</Panel>
