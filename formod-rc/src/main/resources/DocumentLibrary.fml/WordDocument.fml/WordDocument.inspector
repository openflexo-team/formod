<?xml version="1.0" encoding="UTF-8"?>
<!-- Inspector of WordDocument, rebuilt from the Inspector of its legacy .fml.xml serialization. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="WordDocumentInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FMLRTVirtualModelInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<TabPanel name="Tab">
		<Tab title="DocXDocument" layout="twocols" index="0" name="WordDocumentInspectorTab">
			<Label label="file" name="fileLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left)" />
			<TextField data="data.docXDocument.resource.uRI" readOnly="true" name="fileTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right)" />
		</Tab>
	</TabPanel>
</Panel>
