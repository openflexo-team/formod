<?xml version="1.0" encoding="UTF-8"?>
<!-- Inspector of AssociationRightArrowGR, rebuilt from the Inspector of its legacy .fml.xml serialization. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="AssociationRightArrowGRInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FlexoConceptInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<TabPanel name="Tab">
		<Tab title="Association Range" layout="twocols" index="0" name="AssociationRightArrowGRInspectorTab">
			<Label label="cardinality" name="cardinalityLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left)" />
			<TextField data="data.associationGR.modelConcept.rangeCardinality.cardinality" name="cardinalityTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right)" />
		</Tab>
	</TabPanel>
</Panel>
