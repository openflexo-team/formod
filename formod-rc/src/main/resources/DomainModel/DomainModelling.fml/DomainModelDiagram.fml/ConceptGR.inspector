<?xml version="1.0" encoding="UTF-8"?>
<!-- Inspector of ConceptGR, rebuilt from the Inspector of its legacy .fml.xml serialization. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="ConceptGRInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FlexoConceptInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<TabPanel name="Tab">
		<Tab title="Concept" layout="twocols" index="0" name="ConceptGRInspectorTab">
			<Label label="name" name="nameLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left)" />
			<TextField data="data.modelConcept.name" name="nameTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right)" />
			<Label label="is_variable" name="isVariableLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left)" />
			<CheckBox data="data.modelConcept.isVariable" name="isVariableCheckBox" constraints="twocols(expandHorizontally=false;expandVertically=false;location=right)" />
			<Label label="is_enumeration" name="isEnumerationLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left)" />
			<CheckBox data="data.modelConcept.isEnumeration" name="isEnumerationCheckBox" constraints="twocols(expandHorizontally=false;expandVertically=false;location=right)" />
		</Tab>
	</TabPanel>
</Panel>
