<?xml version="1.0" encoding="UTF-8"?>
<!-- Inspector of DomainModelDiagram, rebuilt from the Inspector of its legacy .fml.xml serialization. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="DomainModelDiagramInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FMLRTVirtualModelInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<Label label="name" name="nameLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=1)" />
	<TextField data="data.domainModel.modelName" name="nameTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=1)" />
	<Label label="parentDomainModel" name="parentDomainModelLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=2)" />
	<Custom componentClassName="org.openflexo.fml.rt.controller.widget.FIBVirtualModelInstanceSelector" dataClassForComponent="org.openflexo.foundation.fml.rt.FMLRTVirtualModelInstance" manageDynamicModel="true" data="data.domainModel.parentDomainModel" name="parentDomainModelSelector" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=2)">
		<Assignment variable="component.serviceManager" value="controller.flexoController.applicationContext" mandatory="true" />
	</Custom>
</Panel>
