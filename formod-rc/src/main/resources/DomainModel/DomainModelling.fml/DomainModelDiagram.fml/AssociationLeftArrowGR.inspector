<?xml version="1.0" encoding="UTF-8"?>
<!-- Inspector of AssociationLeftArrowGR, rebuilt from the Inspector of its legacy .fml.xml serialization. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="AssociationLeftArrowGRInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FlexoConceptInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<TabPanel name="Tab">
		<Tab title="Association Domain" layout="twocols" index="0" name="AssociationLeftArrowGRInspectorTab">
			<Label label="cardinality" name="cardinalityLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left)" />
			<TextField data="data.associationGR.modelConcept.domainCardinality.cardinality" name="cardinalityTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right)" />
		</Tab>
	</TabPanel>
</Panel>
