<?xml version="1.0" encoding="UTF-8"?>
<!-- Inspector of SimpleMapletIndividualGR, rebuilt from the Inspector of its legacy .fml.xml serialization. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="SimpleMapletIndividualGRInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FlexoConceptInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<TabPanel name="Tab">
		<Tab title="Maplet Individual" layout="twocols" index="0" name="SimpleMapletIndividualGRInspectorTab">
			<Label label="name" name="nameLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left)" />
			<TextField data="data.individual.individualOf.name" readOnly="true" name="nameTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right)" />
			<Label label="antecedent" name="antecedentLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left)" />
			<TextField data="data.individual.antecedent.name" readOnly="true" name="antecedentTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right)" />
			<Label label="image" name="imageLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left)" />
			<TextField data="data.individual.image.name" readOnly="true" name="imageTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right)" />
		</Tab>
	</TabPanel>
</Panel>
