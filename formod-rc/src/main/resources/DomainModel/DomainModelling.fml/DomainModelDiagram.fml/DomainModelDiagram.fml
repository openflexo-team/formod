	/** The connector from a concept to its parent concept */
	public concept ParentConceptGR {

		DiagramConnector parentConceptShape with ConnectorRole(metamodelElement=PARENT_CONCEPT_CONNECTOR);
		ConceptGR childConceptGR with ConceptInstance(virtualModelInstance=container);
		ConceptGR parentConceptGR with ConceptInstance(virtualModelInstance=container);

		boolean isView {
			boolean get() {
				return container.domainModel != childConceptGR.modelConcept.container
						&& container.domainModel != parentConceptGR.modelConcept.container;
			}
		};

		linkConceptGRToConceptGR() with LinkScheme(fromType=ConceptGR, toType=ConceptGR) {
			childConceptGR = fromTarget;
			parentConceptGR = toTarget;
			parentConceptShape = DIAGRAM::AddConnector(fromShape=fromTarget.containerShape, toShape=toTarget.containerShape)
					in (container.diagram);
			childConceptGR.modelConcept.parentConcept = parentConceptGR.modelConcept;
		}

		create(ConceptGR fromGR, ConceptGR toGR) {
			childConceptGR = parameters.fromGR;
			parentConceptGR = parameters.toGR;
			parentConceptShape = DIAGRAM::AddConnector(fromShape=childConceptGR.containerShape, toShape=parentConceptGR.containerShape)
					in (container.diagram);
		}

		public delete() {
