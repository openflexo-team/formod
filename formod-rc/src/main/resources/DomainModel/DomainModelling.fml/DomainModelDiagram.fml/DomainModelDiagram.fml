		}
	}

	/** A maplet individual (antecedent |-> image): a box between the two individuals, with a connector to each */
	public concept MapletIndividualGR extends IndividualGR {

		DiagramShape individualShape with ShapeRole(metamodelElement=MI_SHAPE);
		DiagramShape icon with ShapeRole(metamodelElement=MI_ICON, containerElement=individualShape);
		DiagramShape label with ShapeRole(metamodelElement=MI_LABEL, containerElement=individualShape, exampleLabel="Maplet",
				label=individual.name);
		DiagramShape attributeValues with ShapeRole(metamodelElement=MI_ATTRIBUTE_VALUES, containerElement=individualShape);
		DiagramShape varIcon with ShapeRole(metamodelElement=MI_VAR_ICON, containerElement=individualShape,
				label=(individual.isVariable ? "" : "X"), transparency=(individual.isVariable ? 1.0 : 0.5));
		MapletIndividual individual with ConceptInstance(virtualModelInstance=container.domainModel);
		MapletIndividualAntecedentGR mapletIndividualAntecedentGR with ConceptInstance(virtualModelInstance=container);
		MapletIndividualImageGR mapletIndividualImageGR with ConceptInstance(virtualModelInstance=container);

		dropMapletIndividualGRAtTopLevel(String name, boolean isVariable) with DropScheme(targetType=DomainModelDiagram) {
			individualShape = DIAGRAM::AddShape(container=container.diagram) in (container.diagram);
			icon = DIAGRAM::AddShape(container=individualShape) in (container.diagram);
			label = DIAGRAM::AddShape(container=individualShape) in (container.diagram);
			attributeValues = DIAGRAM::AddShape(container=individualShape) in (container.diagram);
			varIcon = DIAGRAM::AddShape(container=individualShape) in (container.diagram);
			individual = container.domainModel.new MapletIndividual(parameters.name, null, null, null, parameters.isVariable, null);
		}

		createMapletIndividual(String name, boolean isVariable) with LinkScheme(fromType=IndividualGR, toType=IndividualGR) {
			individual = container.domainModel.new MapletIndividual(parameters.name, null, fromTarget.individual, toTarget.individual,
					parameters.isVariable, null);
			individualShape = DIAGRAM::AddShape(container=container.diagram) in (container.diagram);
			icon = DIAGRAM::AddShape(container=individualShape) in (container.diagram);
			label = DIAGRAM::AddShape(container=individualShape) in (container.diagram);
			attributeValues = DIAGRAM::AddShape(container=individualShape) in (container.diagram);
			varIcon = DIAGRAM::AddShape(container=individualShape) in (container.diagram);
			mapletIndividualImageGR = container.new MapletIndividualImageGR(toTarget, this);
			mapletIndividualAntecedentGR = container.new MapletIndividualAntecedentGR(fromTarget, this);
			// Lay the maplet out halfway between the two individuals
			DIAGRAM::GraphicalAction(subject=individualShape, graphicalFeatureName="x",
					value=((fromTarget.individualShape.graphicalRepresentation.x + fromTarget.individualShape.graphicalRepresentation.width / 2
							+ toTarget.individualShape.graphicalRepresentation.x + toTarget.individualShape.graphicalRepresentation.width / 2) / 2
							- individualShape.graphicalRepresentation.width / 2)) in (container.diagram);
			DIAGRAM::GraphicalAction(subject=individualShape, graphicalFeatureName="y",
					value=((fromTarget.individualShape.graphicalRepresentation.y + fromTarget.individualShape.graphicalRepresentation.height / 2
							+ toTarget.individualShape.graphicalRepresentation.y + toTarget.individualShape.graphicalRepresentation.height / 2) / 2
							- individualShape.graphicalRepresentation.height / 2)) in (container.diagram);
		}

		representMapletIndividualGRAtTopLevel(MapletIndividual individual) with DropScheme(targetType=DomainModelDiagram) {
			individualShape = DIAGRAM::AddShape(container=container.diagram) in (container.diagram);
			icon = DIAGRAM::AddShape(container=individualShape) in (container.diagram);
			label = DIAGRAM::AddShape(container=individualShape) in (container.diagram);
			attributeValues = DIAGRAM::AddShape(container=individualShape) in (container.diagram);
			varIcon = DIAGRAM::AddShape(container=individualShape) in (container.diagram);
			individual = parameters.individual;
			if (individual.antecedent != null) {
				IndividualGR antecedentGR = select unique IndividualGR from container where (selected.individual == individual.antecedent);
				if (antecedentGR != null) {
					mapletIndividualAntecedentGR = container.new MapletIndividualAntecedentGR(antecedentGR, this);
				}
			}
			if (individual.image != null) {
				IndividualGR imageGR = select unique IndividualGR from container where (selected.individual == individual.image);
				if (imageGR != null) {
					mapletIndividualImageGR = container.new MapletIndividualImageGR(imageGR, this);
				}
			}
			this.representAdditionnalIndividualLinks();
		}

		public delete() {
			if (mapletIndividualImageGR != null) {
				delete mapletIndividualImageGR;
			}
			if (mapletIndividualAntecedentGR != null) {
				delete mapletIndividualAntecedentGR;
			}
			delete icon;
			delete label;
			delete individualShape;
			delete attributeValues;
			delete varIcon;
			for (IndividualAttributeGR item : select IndividualAttributeGR from container where (selected.individualGR == this)) {
				delete item;
			}
			for (IndividualOfGR item : select IndividualOfGR from container where (selected.individualGR == this)) {
				delete item;
			}
			for (InitialValueGR item : select InitialValueGR from container
					where (selected.fromIndividualGR == this || selected.toIndividualGR == this)) {
				delete item;
			}
			for (MapletIndividualAntecedentGR item : select MapletIndividualAntecedentGR from container
					where (selected.individualGR == this)) {
				delete item;
			}
			for (MapletIndividualImageGR item : select MapletIndividualImageGR from container where (selected.individualGR == this)) {
				delete item;
			}
			for (SimpleMapletIndividualGR item : select SimpleMapletIndividualGR from container
					where (selected.fromIndividualGR == this || selected.toIndividualGR == this)) {
				delete item;
			}
			delete individual;
		}

		public delete::deleteView() {
			delete individualShape;
			delete icon;
			delete label;
			delete attributeValues;
			delete varIcon;
			for (IndividualAttributeGR item : select IndividualAttributeGR from container where (selected.individualGR == this)) {
				item.deleteView();
			}
			for (IndividualOfGR item : select IndividualOfGR from container where (selected.individualGR == this)) {
				item.deleteView();
			}
			for (InitialValueGR item : select InitialValueGR from container
					where (selected.fromIndividualGR == this || selected.toIndividualGR == this)) {
				item.deleteView();
			}
			for (MapletIndividualAntecedentGR item : select MapletIndividualAntecedentGR from container
					where (selected.individualGR == this)) {
				item.deleteView();
			}
			for (MapletIndividualImageGR item : select MapletIndividualImageGR from container where (selected.individualGR == this)) {
				item.deleteView();
			}
			for (SimpleMapletIndividualGR item : select SimpleMapletIndividualGR from container
					where (selected.fromIndividualGR == this || selected.toIndividualGR == this)) {
				item.deleteView();
			}
			individual = null;
			mapletIndividualAntecedentGR = null;
			mapletIndividualImageGR = null;
		}

		/** Replace the maplet box by a single connector from the antecedent to the image */
		public simplifyView() {
			container.new SimpleMapletIndividualGR(mapletIndividualAntecedentGR.individualGR, mapletIndividualImageGR.individualGR,
					individual);
			this.deleteView();
		}
	}

	/** The connector from an individual to the maplet it is the antecedent of */
	public concept MapletIndividualAntecedentGR {

		DiagramConnector antecedentShape with ConnectorRole(metamodelElement=MAPLET_ANTECEDENT_CONNECTOR);
		IndividualGR individualGR with ConceptInstance(virtualModelInstance=container);
		MapletIndividualGR mapletIndividualGR with ConceptInstance(virtualModelInstance=container);

		boolean isView {
			boolean get() {
				return container.domainModel != individualGR.individual.container
						&& container.domainModel != mapletIndividualGR.individual.container;
			}
		};

		linkIndividualGRToMapletIndividualGR() with LinkScheme(fromType=IndividualGR, toType=MapletIndividualGR) {
			individualGR = fromTarget;
			mapletIndividualGR = toTarget;
			antecedentShape = DIAGRAM::AddConnector(fromShape=individualGR.individualShape, toShape=mapletIndividualGR.individualShape)
					in (container.diagram);
			mapletIndividualGR.individual.antecedent = individualGR.individual;
			mapletIndividualGR.mapletIndividualAntecedentGR = this;
		}

		create(IndividualGR individualGR, MapletIndividualGR mapletIndividualGR) {
			individualGR = parameters.individualGR;
			mapletIndividualGR = parameters.mapletIndividualGR;
			antecedentShape = DIAGRAM::AddConnector(fromShape=individualGR.individualShape, toShape=mapletIndividualGR.individualShape)
					in (container.diagram);
		}

		public delete() {
			delete antecedentShape;
			mapletIndividualGR.individual.antecedent = null;
			individualGR = null;
			mapletIndividualGR = null;
		}

		public delete::deleteView() {
			delete antecedentShape;
			individualGR = null;
			mapletIndividualGR = null;
		}
	}

	/** The connector from a maplet to the individual that is its image */
	public concept MapletIndividualImageGR {

		DiagramConnector imageShape with ConnectorRole(metamodelElement=MAPLET_IMAGE_CONNECTOR);
		IndividualGR individualGR with ConceptInstance(virtualModelInstance=container);
		MapletIndividualGR mapletIndividualGR with ConceptInstance(virtualModelInstance=container);

		boolean isView {
			boolean get() {
				return container.domainModel != individualGR.individual.container
						&& container.domainModel != mapletIndividualGR.individual.container;
			}
		};

		linkMapletIndividualGRToIndividualGR() with LinkScheme(fromType=MapletIndividualGR, toType=IndividualGR) {
			mapletIndividualGR = fromTarget;
			individualGR = toTarget;
			imageShape = DIAGRAM::AddConnector(fromShape=mapletIndividualGR.individualShape, toShape=individualGR.individualShape)
					in (container.diagram);
			mapletIndividualGR.individual.image = individualGR.individual;
			mapletIndividualGR.mapletIndividualImageGR = this;
		}

		create(IndividualGR individualGR, MapletIndividualGR mapletIndividualGR) {
			individualGR = parameters.individualGR;
			mapletIndividualGR = parameters.mapletIndividualGR;
			imageShape = DIAGRAM::AddConnector(fromShape=mapletIndividualGR.individualShape, toShape=individualGR.individualShape)
					in (container.diagram);
		}

		public delete() {
			delete imageShape;
			mapletIndividualGR.individual.image = null;
			individualGR = null;
			mapletIndividualGR = null;
		}

		public delete::deleteView() {
			delete imageShape;
			individualGR = null;
			mapletIndividualGR = null;
		}
	}

	/** One of the default data types of the root domain model (NATURAL, INTEGER, FLOAT, STRING, BOOL) */
	public concept DefaultDataTypeGR extends ConceptGR {

		DiagramShape containerShape with ShapeRole(metamodelElement=DT_CONTAINER);
		DiagramShape enumIcon with ShapeRole(metamodelElement=DT_ENUM_ICON, containerElement=containerShape,
				label=(modelConcept.isEnumeration ? "" : "X"), transparency=(modelConcept.isEnumeration ? 1.0 : 0.5));
		DiagramShape label with ShapeRole(metamodelElement=DT_LABEL, containerElement=containerShape, exampleLabel="DataType",
				label=modelConcept.name);
		DiagramShape icon with ShapeRole(metamodelElement=DT_ICON, containerElement=containerShape);
		DefaultDataType modelConcept with ConceptInstance(virtualModelInstance=container.domainModel);

		dropDefaultDataTypeGRAtTopLevel(DefaultDataTypeEnum dataType) with DropScheme(targetType=DomainModelDiagram) {
			containerShape = DIAGRAM::AddShape(container=container.diagram) in (container.diagram);
			enumIcon = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			label = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			icon = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			modelConcept = select unique DefaultDataType from container.container.rootDomainModel
					where (selected.name.equalsIgnoreCase("" + parameters.dataType));
		}

		representDefaultDataTypeGRAtTopLevel(DefaultDataType dataType) with DropScheme(targetType=DomainModelDiagram) {
			containerShape = DIAGRAM::AddShape(container=container.diagram) in (container.diagram);
			enumIcon = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			label = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			icon = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			modelConcept = parameters.dataType;
			this.representAdditionnalConceptLinks();
		}

		/** A default data type belongs to the root domain model: deleting its representation never deletes it */
		public delete() {
			for (IndividualOfGR item : select IndividualOfGR from container where (selected.conceptGR == this)) {
				delete item;
			}
			for (AssociationLeftArrowGR item : select AssociationLeftArrowGR from container where (selected.conceptGR == this)) {
				delete item;
			}
			for (AssociationRightArrowGR item : select AssociationRightArrowGR from container where (selected.conceptGR == this)) {
				delete item;
			}
			for (ParentConceptGR item : select ParentConceptGR from container
					where (selected.childConceptGR == this || selected.parentConceptGR == this)) {
				delete item;
			}
			for (ConceptAttributeGR item : select ConceptAttributeGR from container where (selected.conceptGR == this)) {
				delete item;
			}
			delete containerShape;
			delete enumIcon;
			delete label;
			delete icon;
			modelConcept = null;
		}

		public delete::deleteView() {
			for (IndividualOfGR item : select IndividualOfGR from container where (selected.conceptGR == this)) {
				item.deleteView();
			}
			for (AssociationLeftArrowGR item : select AssociationLeftArrowGR from container where (selected.conceptGR == this)) {
				item.deleteView();
			}
			for (AssociationRightArrowGR item : select AssociationRightArrowGR from container where (selected.conceptGR == this)) {
				item.deleteView();
			}
			for (ParentConceptGR item : select ParentConceptGR from container
					where (selected.childConceptGR == this || selected.parentConceptGR == this)) {
				item.deleteView();
			}
			for (ConceptAttributeGR item : select ConceptAttributeGR from container where (selected.conceptGR == this)) {
				item.deleteView();
			}
			delete containerShape;
			delete enumIcon;
			delete label;
			delete icon;
			modelConcept = null;
		}

		public changeType(DefaultDataTypeEnum newType) {
			DefaultDataType dataType = select unique DefaultDataType from container.container.rootDomainModel
					where (selected.name.equalsIgnoreCase("" + parameters.newType));
			modelConcept = dataType;
		}
	}

	/** A maplet shown as a single connector from its antecedent to its image */
	public concept SimpleMapletIndividualGR {

		DiagramConnector connector with ConnectorRole(metamodelElement=SIMPLE_MAPLET_CONNECTOR, label=individual.individualOf.name);
		IndividualGR fromIndividualGR with ConceptInstance(virtualModelInstance=container);
		IndividualGR toIndividualGR with ConceptInstance(virtualModelInstance=container);
		MapletIndividual individual with ConceptInstance(virtualModelInstance=container.domainModel);

		boolean isView {
			boolean get() {
				return container.domainModel != individual.container;
			}
		};

		linkIndividualGRToIndividualGR(Association association) with LinkScheme(fromType=IndividualGR, toType=IndividualGR) {
			connector = DIAGRAM::AddConnector(fromShape=fromTarget.individualShape, toShape=toTarget.individualShape)
					in (container.diagram);
			fromIndividualGR = fromTarget;
			toIndividualGR = toTarget;
			individual = container.domainModel.new MapletIndividual(null, parameters.association, fromIndividualGR.individual,
					toIndividualGR.individual, false, null);
		}

		create(IndividualGR fromGR, IndividualGR toGR, MapletIndividual individual) {
			fromIndividualGR = parameters.fromGR;
			toIndividualGR = parameters.toGR;
			connector = DIAGRAM::AddConnector(fromShape=fromIndividualGR.individualShape, toShape=toIndividualGR.individualShape)
					in (container.diagram);
			individual = parameters.individual;
		}

		public delete() {
			delete connector;
			delete individual;
			fromIndividualGR = null;
			toIndividualGR = null;
		}

		public delete::deleteView() {
			delete connector;
			fromIndividualGR = null;
			toIndividualGR = null;
			individual = null;
		}
	}

	/** An attribute of a concept (an association from the concept to a data type), shown as a line inside the concept box */
	public concept ConceptAttributeGR {

		DiagramShape attributeLabel with ShapeRole(metamodelElement=ATTRIBUTE_LABEL, exampleLabel="attribute : TYPE",
				label=(modelConcept.name + " : " + modelConcept.range.name
						+ (modelConcept.rangeCardinality.cardinality.equals("1") ? "" : " (" + modelConcept.rangeCardinality.cardinality + ")")
						+ (modelConcept.isVariable ? " <<variable>>" : "")));
		ConceptGR conceptGR with ConceptInstance(virtualModelInstance=container);
		Association modelConcept with ConceptInstance(virtualModelInstance=container.domainModel);

		boolean isView {
			boolean get() {
				return container.domainModel != modelConcept.container;
			}
		};

		dropAttributeGRonConceptGR(String name, DefaultDataTypeEnum dataType, boolean isVariable, String rangeCardinality)
				with DropScheme(targetType=ConceptGR) {
			conceptGR = target;
			DefaultDataType rangeDataType = select unique DefaultDataType from container.container.rootDomainModel
					where (selected.name.equalsIgnoreCase("" + parameters.dataType));
			Cardinality domainCardinality = container.domainModel.new Cardinality("0..*");
			Cardinality rangeCardinality = container.domainModel.new Cardinality(parameters.rangeCardinality);
			modelConcept = container.domainModel.new Association(parameters.name, parameters.isVariable, false, null,
					conceptGR.modelConcept, rangeDataType, domainCardinality, rangeCardinality, false, false, false, false, false);
			attributeLabel = DIAGRAM::AddShape(container=conceptGR.attributes) in (container.diagram);
			log "addition of an attribute in a concept";
			conceptGR.refreshConcept();
		}

		representAssociationGRInConcept(Association association) with DropScheme(targetType=ConceptGR) {
			conceptGR = target;
			if (parameters.association.domain != null && parameters.association.domain == conceptGR.modelConcept) {
				modelConcept = parameters.association;
				attributeLabel = DIAGRAM::AddShape(container=conceptGR.attributes) in (container.diagram);
			}
			conceptGR.refreshConcept();
		}

		public delete() {
			delete modelConcept;
			if (attributeLabel != null) {
				delete attributeLabel;
			}
			conceptGR.refreshConcept();
			conceptGR = null;
		}

		public delete::deleteView() {
			delete attributeLabel;
			conceptGR.refreshConcept();
		}

		public setAttributeRange(DefaultDataTypeEnum newType) {
			DefaultDataType dataType = select unique DefaultDataType from container.container.rootDomainModel
					where (selected.name.equalsIgnoreCase("" + parameters.newType));
			modelConcept.range = dataType;
		}

		public setAssociationRange(Concept newType) {
			modelConcept.range = parameters.newType;
		}
	}

	/** The value of an attribute of an individual (a maplet of the attribute), shown as a line inside the individual box */
	public concept IndividualAttributeGR {

		DiagramShape attributeLabel with ShapeRole(metamodelElement=ATTRIBUTE_LABEL, exampleLabel="attribute = 'value'",
				label=(individual.individualOf.name + " = '" + individual.image.name + "'"));
		IndividualGR individualGR with ConceptInstance(virtualModelInstance=container);
		MapletIndividual individual with ConceptInstance(virtualModelInstance=container.domainModel);

		boolean isView {
			boolean get() {
				return container.domainModel != individual.container;
			}
		};

		dropAttributeGRonIndividualGR(Association attribute, Individual valueIndividual, String valueString)
				with DropScheme(targetType=IndividualGR) {
			individualGR = target;
			if (parameters.attribute.domain != individualGR.individual.individualOf) {
				log "INVALID TYPE";
			}
			individual = container.domainModel.new MapletIndividual("", parameters.attribute, individualGR.individual, null, false, null);
			if (parameters.valueIndividual != null) {
				individual.image = parameters.valueIndividual;
			}
			else {
				individual.image = select unique Individual from container.domainModel
						where (selected.name.equalsIgnoreCase(parameters.valueString));
				if (individual.image == null) {
					individual.image = container.domainModel.new Individual(parameters.valueString, individual.individualOf.range, false,
							null);
				}
			}
			attributeLabel = DIAGRAM::AddShape(container=individualGR.attributeValues) in (container.diagram);
			log "addition of an attribute in an individual";
			individualGR.refreshIndividual();
		}

		representMapletIndividualGRInIndividual(MapletIndividual maplet) with DropScheme(targetType=IndividualGR) {
			individualGR = target;
			if (parameters.maplet.antecedent != null && parameters.maplet.antecedent == individualGR.individual) {
				individual = parameters.maplet;
				attributeLabel = DIAGRAM::AddShape(container=individualGR.attributeValues) in (container.diagram);
			}
			individualGR.refreshIndividual();
		}

		public delete() {
			delete individual;
			if (attributeLabel != null) {
				delete attributeLabel;
			}
			individualGR.refreshIndividual();
			individualGR = null;
		}

		public delete::deleteView() {
			delete attributeLabel;
			individualGR.refreshIndividual();
		}

		public setAttributeType(Association newType) {
			if (parameters.newType.domain != individualGR.individual.individualOf) {
				log "INVALID TYPE";
			}
			individual.individualOf = parameters.newType;
		}

		public setAttributeValue(Individual newValue) {
			if (parameters.newValue.individualOf != individual.individualOf.range) {
				log "INVALID VALUE";
			}
			individual.image = parameters.newValue;
		}
	}

	/** The pane listing the logical formulas of the domain model */
	public concept LogicalFormulaPaneGR {

		DiagramShape logicalFormulas with ShapeRole(metamodelElement=LF_PANE);
		DiagramShape label with ShapeRole(metamodelElement=LF_PANE_LABEL, containerElement=logicalFormulas, label="Logical Formulas");
		DiagramShape formulas with ShapeRole(metamodelElement=LF_PANE_FORMULAS, containerElement=logicalFormulas);

		create(DomainModelDiagram aDiagram) {
			logicalFormulas = DIAGRAM::AddShape(container=parameters.aDiagram.diagram) in (parameters.aDiagram.diagram);
			label = DIAGRAM::AddShape(container=logicalFormulas) in (parameters.aDiagram.diagram);
			formulas = DIAGRAM::AddShape(container=logicalFormulas) in (parameters.aDiagram.diagram);
			DIAGRAM::GraphicalAction(subject=logicalFormulas, graphicalFeatureName="width",
					value=(parameters.aDiagram.diagram.graphicalRepresentation.width - 60)) in (parameters.aDiagram.diagram);
		}

		delete() {
			delete logicalFormulas;
			delete label;
			delete formulas;
		}

		/** Lay the formulas out, one line each */
		public refreshFormulaPanel() {
			int counter = 0;
			for (DiagramShape item : formulas.shapes) {
				item.graphicalRepresentation.y = counter * 20;
				counter = counter + 1;
			}
		}
	}

	/** A logical formula, shown as a line of the formula pane */
	public concept LogicalFormulaGR {

		LogicalFormula logicalFormula with ConceptInstance(virtualModelInstance=container.domainModel);
		DiagramShape logicalFormulaShape with ShapeRole(metamodelElement=LF_SHAPE, label=logicalFormula.assertion);
		LogicalFormulaPaneGR logicalFormulaPaneGR with ConceptInstance(virtualModelInstance=container);

		dropLogicalFormulaGROnFormulaPane(String formula) with DropScheme(targetType=LogicalFormulaPaneGR) {
			logicalFormulaPaneGR = target;
			logicalFormula = container.domainModel.new LogicalFormula(parameters.formula);
			logicalFormulaShape = DIAGRAM::AddShape(container=logicalFormulaPaneGR.formulas) in (container.diagram);
			logicalFormulaPaneGR.refreshFormulaPanel();
		}

		create(LogicalFormula formula, LogicalFormulaPaneGR aLogicalFormulaPane) {
			logicalFormula = parameters.formula;
			logicalFormulaPaneGR = parameters.aLogicalFormulaPane;
			logicalFormulaShape = DIAGRAM::AddShape(container=logicalFormulaPaneGR.formulas) in (container.diagram);
			logicalFormulaPaneGR.refreshFormulaPanel();
		}

		public delete() {
			delete logicalFormula;
			if (logicalFormulaShape != null) {
				delete logicalFormulaShape;
			}
			logicalFormulaPaneGR.refreshFormulaPanel();
		}
	}
}
