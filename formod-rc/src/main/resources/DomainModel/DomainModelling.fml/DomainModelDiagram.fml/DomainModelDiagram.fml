			childConceptGR.modelConcept.parentConcept = null;
			childConceptGR = null;
			parentConceptGR = null;
		}

		public delete::deleteView() {
			delete parentConceptShape;
			childConceptGR = null;
			parentConceptGR = null;
		}
	}

	/** The connector from an individual to the individual that is its initial value */
	public concept InitialValueGR {

		DiagramConnector connector with ConnectorRole(metamodelElement=INITIAL_VALUE_CONNECTOR);
		IndividualGR fromIndividualGR with ConceptInstance(virtualModelInstance=container);
		IndividualGR toIndividualGR with ConceptInstance(virtualModelInstance=container);

		boolean isView {
			boolean get() {
				return container.domainModel != fromIndividualGR.individual.container
						&& container.domainModel != toIndividualGR.individual.container;
			}
		};

		linkIndividualGRToIndividualGR() with LinkScheme(fromType=IndividualGR, toType=IndividualGR) {
