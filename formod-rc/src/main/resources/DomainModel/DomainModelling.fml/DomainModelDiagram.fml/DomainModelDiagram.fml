/**
 * Diagrammatic editor of a domain model: every GR concept ("graphical representation") pairs diagram elements with the DomainModel
 * object they stand for. Dropping a shape creates the model object, drawing a connector wires the model, and the
 * representXxx drop schemes and representAdditionnalXxxLinks behaviours draw what the model already holds.
 *
 * Each GR concept has two deletion schemes: delete(), which removes the diagram elements AND the model object they stand for, and
 * deleteView(), which removes the diagram elements only (the object stays in the domain model, and may be shown again).
 *
 * Migrated from the legacy DomainModelDiagram.fml.xml serialization (formod 2.1). URIs follow the 2.99 convention (resource center
 * base URI + relative path): this model is http://formose.lacl.fr/DomainModel/DomainModelling.fml/DomainModelDiagram.fml, and its
 * diagram specification http://formose.lacl.fr/DomainModel/DomainModelDiagramSpec.diagramspecification.
 *
 * The legacy names are kept, misspellings included (representAdditionnalConceptLinks, assocationGR), because the Formose module
 * reads them.
 *
 * Deliberate divergences from the legacy model:
 * - delete() is declared before deleteView() in every concept, DefaultDataTypeGR included (the legacy declared its deleteView
 *   first): "delete x;" runs the FIRST deletion scheme of a concept, and the cascades must remove the model object with it
 *   (see CORE-F-2); the cascades removing the view only call deleteView() explicitly;
 * - parameters named "from", "to" and "concept" became fromGR, toGR and aConcept, and the parameter "diagram" of
 *   LogicalFormulaPaneGR.create became aDiagram: the first three are keywords in 2.99, the last one hid the diagram slot;
 * - the legacy added the sub-shapes of MapletIndividualGR to "mapletIndividual" and those of DefaultDataTypeGR to "conceptShape",
 *   two roles neither concept has: they are added to the individualShape / containerShape the ShapeRoles declare as their
 *   container;
 * - shapes the legacy added to "topLevel" are added to the diagram slot, and the legacy navigation individualGR.diagram.diagram,
 *   conceptGR.diagram and the like is written container.diagram;
 * - rootDomainModel, a role of the containing DomainModelling, is read as container.rootDomainModel from the model and
 *   container.container.rootDomainModel from a concept;
 * - ConceptAttributeGR.delete and IndividualAttributeGR.delete refreshed the concept (the individual) AFTER setting it to null,
 *   so the refresh never ran: they refresh it first;
 * - the palette bindings pass their drop scheme arguments explicitly, the values the legacy dialogs started from: a parameterless
 *   call only resolves for a concept declaring no creation scheme (see CORE-D-13);
 * - the legacy read the name of a DefaultDataTypeEnum value with dataType.toString, which does not resolve on an FML enum type:
 *   it is read as "" + dataType, which converts the value to its name;
 * - the legacy used "=" where it meant ==, "|" for || and "&" for &&;
 * - inspectors and icons are gone: FlexoConceptInspector is deprecated in 2.99; the icons follow in the user interface step.
 *
 * @version 0.1
 */

use org.openflexo.foundation.fml.rt.FMLRTModelSlot as FMLRT;
use org.openflexo.technologyadapter.diagram.TypedDiagramModelSlot as DIAGRAM;

import org.openflexo.technologyadapter.diagram.model.Diagram;
import org.openflexo.technologyadapter.diagram.model.DiagramShape;
import org.openflexo.technologyadapter.diagram.model.DiagramConnector;
import org.openflexo.technologyadapter.diagram.metamodel.DiagramSpecification;

import ["http://formose.lacl.fr/DomainModel/DomainModelling.fml/DomainModel.fml"];
import DiagramSpecification DOMAIN_MODEL_DIAGRAM from ["http://formose.lacl.fr/DomainModel/DomainModelDiagramSpec.diagramspecification"];
import Diagram EXAMPLE_DIAGRAM from ["http://formose.lacl.fr/DomainModel/DomainModelDiagramSpec.diagramspecification/ExampleDiagram.diagram"];
import DiagramShape C_CONTAINER from [EXAMPLE_DIAGRAM:"SYL-51"];
import DiagramShape C_ENUM_ICON from [EXAMPLE_DIAGRAM:"SYL-52"];
import DiagramShape C_LABEL from [EXAMPLE_DIAGRAM:"SYL-53"];
import DiagramShape C_ATTRIBUTES from [EXAMPLE_DIAGRAM:"SYL-55"];
import DiagramShape C_VAR_ICON from [EXAMPLE_DIAGRAM:"SYL-56"];
import DiagramShape C_ICON from [EXAMPLE_DIAGRAM:"FLX-124"];
import DiagramShape DC_CONTAINER from [EXAMPLE_DIAGRAM:"SYL-63"];
import DiagramShape DC_ENUM_ICON from [EXAMPLE_DIAGRAM:"SYL-64"];
import DiagramShape DC_LABEL from [EXAMPLE_DIAGRAM:"SYL-65"];
import DiagramShape DC_ATTRIBUTES from [EXAMPLE_DIAGRAM:"SYL-67"];
import DiagramShape DC_VAR_ICON from [EXAMPLE_DIAGRAM:"SYL-68"];
import DiagramShape DC_ICON from [EXAMPLE_DIAGRAM:"FLX-125"];
import DiagramShape I_SHAPE from [EXAMPLE_DIAGRAM:"SYL-30"];
import DiagramShape I_ICON from [EXAMPLE_DIAGRAM:"SYL-31"];
import DiagramShape I_LABEL from [EXAMPLE_DIAGRAM:"SYL-32"];
import DiagramShape I_ATTRIBUTE_VALUES from [EXAMPLE_DIAGRAM:"SYL-33"];
import DiagramShape I_VAR_ICON from [EXAMPLE_DIAGRAM:"SYL-69"];
import DiagramShape A_CONTAINER from [EXAMPLE_DIAGRAM:"SYL-95"];
import DiagramShape A_ENUM_ICON from [EXAMPLE_DIAGRAM:"SYL-96"];
import DiagramShape A_LABEL from [EXAMPLE_DIAGRAM:"SYL-97"];
import DiagramShape A_ATTRIBUTES from [EXAMPLE_DIAGRAM:"SYL-99"];
import DiagramShape A_VAR_ICON from [EXAMPLE_DIAGRAM:"SYL-100"];
import DiagramShape A_ICON from [EXAMPLE_DIAGRAM:"FLX-126"];
import DiagramShape MI_SHAPE from [EXAMPLE_DIAGRAM:"SYL-116"];
import DiagramShape MI_ICON from [EXAMPLE_DIAGRAM:"SYL-117"];
import DiagramShape MI_LABEL from [EXAMPLE_DIAGRAM:"SYL-118"];
import DiagramShape MI_ATTRIBUTE_VALUES from [EXAMPLE_DIAGRAM:"SYL-120"];
import DiagramShape MI_VAR_ICON from [EXAMPLE_DIAGRAM:"SYL-121"];
import DiagramShape DT_CONTAINER from [EXAMPLE_DIAGRAM:"SYL-57"];
import DiagramShape DT_ENUM_ICON from [EXAMPLE_DIAGRAM:"SYL-58"];
import DiagramShape DT_LABEL from [EXAMPLE_DIAGRAM:"SYL-59"];
import DiagramShape DT_ICON from [EXAMPLE_DIAGRAM:"FLX-127"];
import DiagramShape ATTRIBUTE_LABEL from [EXAMPLE_DIAGRAM:"SYL-54"];
import DiagramShape LF_PANE from [EXAMPLE_DIAGRAM:"SYL-139"];
import DiagramShape LF_PANE_LABEL from [EXAMPLE_DIAGRAM:"SYL-141"];
import DiagramShape LF_PANE_FORMULAS from [EXAMPLE_DIAGRAM:"SYL-143"];
import DiagramShape LF_SHAPE from [EXAMPLE_DIAGRAM:"SYL-142"];
import DiagramConnector INDIVIDUAL_OF_CONNECTOR from [EXAMPLE_DIAGRAM:"SYL-70"];
import DiagramConnector ASSOCIATION_LEFT_CONNECTOR from [EXAMPLE_DIAGRAM:"STE-104"];
import DiagramConnector ASSOCIATION_RIGHT_CONNECTOR from [EXAMPLE_DIAGRAM:"STE-106"];
import DiagramConnector PARENT_CONCEPT_CONNECTOR from [EXAMPLE_DIAGRAM:"STE-107"];
import DiagramConnector INITIAL_VALUE_CONNECTOR from [EXAMPLE_DIAGRAM:"STE-109"];
import DiagramConnector MAPLET_ANTECEDENT_CONNECTOR from [EXAMPLE_DIAGRAM:"STE-122"];
import DiagramConnector MAPLET_IMAGE_CONNECTOR from [EXAMPLE_DIAGRAM:"STE-123"];
import DiagramConnector SIMPLE_MAPLET_CONNECTOR from [EXAMPLE_DIAGRAM:"STE-135"];

@URI("http://formose.lacl.fr/DomainModel/DomainModelling.fml/DomainModelDiagram.fml")
@Version("0.1")
public model DomainModelDiagram {

	Diagram diagram with TypedDiagram(
			diagramSpecification=DOMAIN_MODEL_DIAGRAM,
			paletteElementBindings={
					PaletteElementBinding:(call=new ConceptGR::dropConceptGRAtTopLevel("Concept", false, false),
							paletteElementId="http://formose.lacl.fr/DomainModel/DomainModelDiagramSpec.diagramspecification/Palette.palette#Concept"),
					PaletteElementBinding:(call=new DefinedConceptGR::dropDefinedConceptGRAtTopLevel("DefConcept", "", false, false),
							paletteElementId="http://formose.lacl.fr/DomainModel/DomainModelDiagramSpec.diagramspecification/Palette.palette#DefConcept"),
					PaletteElementBinding:(call=new IndividualGR::dropIndividualGRAtTopLevel("Individual", false),
							paletteElementId="http://formose.lacl.fr/DomainModel/DomainModelDiagramSpec.diagramspecification/Palette.palette#Individual"),
					PaletteElementBinding:(call=new AssociationGR::dropAssociationGRAtTopLevel("Association", false, false),
							paletteElementId="http://formose.lacl.fr/DomainModel/DomainModelDiagramSpec.diagramspecification/Palette.palette#Association"),
					PaletteElementBinding:(call=new MapletIndividualGR::dropMapletIndividualGRAtTopLevel("Maplet", false),
							paletteElementId="http://formose.lacl.fr/DomainModel/DomainModelDiagramSpec.diagramspecification/Palette.palette#MapletInd"),
					PaletteElementBinding:(call=new DefaultDataTypeGR::dropDefaultDataTypeGRAtTopLevel(null),
							paletteElementId="http://formose.lacl.fr/DomainModel/DomainModelDiagramSpec.diagramspecification/Palette.palette#DefaultType"),
					PaletteElementBinding:(call=new ConceptAttributeGR::dropAttributeGRonConceptGR("attribute", null, false, "1"),
							paletteElementId="http://formose.lacl.fr/DomainModel/DomainModelDiagramSpec.diagramspecification/Palette.palette#Attribute"),
					PaletteElementBinding:(call=new IndividualAttributeGR::dropAttributeGRonIndividualGR(null, null, ""),
							paletteElementId="http://formose.lacl.fr/DomainModel/DomainModelDiagramSpec.diagramspecification/Palette.palette#Attribute"),
					PaletteElementBinding:(call=new LogicalFormulaGR::dropLogicalFormulaGROnFormulaPane(""),
							paletteElementId="http://formose.lacl.fr/DomainModel/DomainModelDiagramSpec.diagramspecification/Palette.palette#LogicalFormula")});

	/** The domain model this diagram presents */
	DomainModel domainModel with ModelInstance();

	/** The pane listing the logical formulas of the domain model */
	LogicalFormulaPaneGR logicalFormulaPane with ConceptInstance();

	create::init(DomainModel domainModel, String diagramName) {
		diagram = DIAGRAM::CreateDiagram(resourceName=parameters.diagramName, resourceCenter=this.resourceCenter,
				relativePath="/Diagrams");
		domainModel = parameters.domainModel;
		logicalFormulaPane = new LogicalFormulaPaneGR(this);
	}

	/** A diagram of the root domain model */
	create(String diagramName) {
		domainModel = container.rootDomainModel;
		diagram = DIAGRAM::CreateDiagram(resourceName=parameters.diagramName, resourceCenter=this.resourceCenter,
				relativePath="/Diagrams");
		logicalFormulaPane = new LogicalFormulaPaneGR(this);
	}

	delete() {
	}

	/** A concept of the domain model: a box with a label, enumeration and variable markers, and its attributes */
	public concept ConceptGR {

		DiagramShape containerShape with ShapeRole(metamodelElement=C_CONTAINER);
		DiagramShape enumIcon with ShapeRole(metamodelElement=C_ENUM_ICON, containerElement=containerShape,
				label=(modelConcept.isEnumeration ? "" : "X"), transparency=(modelConcept.isEnumeration ? 1.0 : 0.5));
		DiagramShape label with ShapeRole(metamodelElement=C_LABEL, containerElement=containerShape, exampleLabel="Concept",
				label=modelConcept.name);
		DiagramShape attributes with ShapeRole(metamodelElement=C_ATTRIBUTES, containerElement=containerShape);
		DiagramShape varIcon with ShapeRole(metamodelElement=C_VAR_ICON, containerElement=containerShape,
				label=(modelConcept.isVariable ? "" : "X"), transparency=(modelConcept.isVariable ? 1.0 : 0.5));
		DiagramShape icon with ShapeRole(metamodelElement=C_ICON, containerElement=containerShape);
		Concept modelConcept with ConceptInstance(virtualModelInstance=container.domainModel);

		/** True when the concept belongs to another domain model than the one this diagram presents */
		boolean isView {
			boolean get() {
				return container.domainModel != modelConcept.container;
			}
		};

		dropConceptGRAtTopLevel(String conceptName, boolean isVariable, boolean isEnumeration)
				with DropScheme(targetType=DomainModelDiagram) {
			containerShape = DIAGRAM::AddShape(container=container.diagram) in (container.diagram);
			enumIcon = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			label = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			attributes = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			varIcon = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			modelConcept = container.domainModel.new Concept(parameters.conceptName, parameters.isVariable, parameters.isEnumeration,
					null);
			icon = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
		}

		representConceptGRAtTopLevel(Concept aConcept) with DropScheme(targetType=DomainModelDiagram) {
			containerShape = DIAGRAM::AddShape(container=container.diagram) in (container.diagram);
			enumIcon = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			label = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			attributes = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			varIcon = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			icon = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			modelConcept = parameters.aConcept;
			this.representAdditionnalConceptLinks();
		}

		create(Concept aConcept, DomainModelDiagram aDiagram) {
			containerShape = DIAGRAM::AddShape(container=parameters.aDiagram.diagram) in (parameters.aDiagram.diagram);
			enumIcon = DIAGRAM::AddShape(container=containerShape) in (parameters.aDiagram.diagram);
			label = DIAGRAM::AddShape(container=containerShape) in (parameters.aDiagram.diagram);
			attributes = DIAGRAM::AddShape(container=containerShape) in (parameters.aDiagram.diagram);
			varIcon = DIAGRAM::AddShape(container=containerShape) in (parameters.aDiagram.diagram);
			icon = DIAGRAM::AddShape(container=containerShape) in (parameters.aDiagram.diagram);
			modelConcept = parameters.aConcept;
		}

		public delete() {
			for (IndividualOfGR item : select IndividualOfGR from container where (selected.conceptGR == this)) {
				delete item;
			}
			for (AssociationLeftArrowGR item : select AssociationLeftArrowGR from container where (selected.conceptGR == this)) {
				delete item;
			}
			for (AssociationRightArrowGR item : select AssociationRightArrowGR from container where (selected.conceptGR == this)) {
				delete item;
			}
			for (ParentConceptGR item : select ParentConceptGR from container
					where (selected.childConceptGR == this || selected.parentConceptGR == this)) {
				delete item;
			}
			for (ConceptAttributeGR item : select ConceptAttributeGR from container where (selected.conceptGR == this)) {
				delete item;
			}
			delete containerShape;
			delete enumIcon;
			delete label;
			delete icon;
			delete attributes;
			delete varIcon;
			delete modelConcept;
		}

		public delete::deleteView() {
			for (IndividualOfGR item : select IndividualOfGR from container where (selected.conceptGR == this)) {
				item.deleteView();
			}
			for (AssociationLeftArrowGR item : select AssociationLeftArrowGR from container where (selected.conceptGR == this)) {
				item.deleteView();
			}
			for (AssociationRightArrowGR item : select AssociationRightArrowGR from container where (selected.conceptGR == this)) {
				item.deleteView();
			}
			for (ParentConceptGR item : select ParentConceptGR from container
					where (selected.childConceptGR == this || selected.parentConceptGR == this)) {
				item.deleteView();
			}
			for (ConceptAttributeGR item : select ConceptAttributeGR from container where (selected.conceptGR == this)) {
				item.deleteView();
			}
			delete containerShape;
			delete enumIcon;
			delete label;
			delete icon;
			delete attributes;
			delete varIcon;
			modelConcept = null;
		}

		/** Lay the attribute labels out, one line each */
		public refreshConcept() {
			int counter = 0;
			for (DiagramShape item : attributes.shapes) {
				item.graphicalRepresentation.y = counter * 20;
				counter = counter + 1;
			}
		}

		/** Draw the links between this concept and the concepts, individuals and associations the diagram already shows */
		public representAdditionnalConceptLinks() {
			if (modelConcept.parentConcept != null) {
				ConceptGR parentGR = select unique ConceptGR from container where (selected.modelConcept == modelConcept.parentConcept);
				if (parentGR != null) {
					container.new ParentConceptGR(this, parentGR);
				}
			}
			for (ConceptGR cGR : select ConceptGR from container where (selected.modelConcept.parentConcept == modelConcept)) {
				container.new ParentConceptGR(cGR, this);
			}
			for (IndividualGR iGR : select IndividualGR from container where (selected.individual.individualOf == modelConcept)) {
				container.new IndividualOfGR(iGR, this);
			}
			for (AssociationGR aGR : select AssociationGR from container
					where (selected.modelConcept.domain == modelConcept || selected.modelConcept.range == modelConcept)) {
				if (aGR.modelConcept.domain == modelConcept) {
					container.new AssociationLeftArrowGR(this, aGR);
				}
				if (aGR.modelConcept.range == modelConcept) {
					container.new AssociationRightArrowGR(this, aGR);
				}
			}
		}
	}

	/** A concept defined by a logical formula, which the formula pane lists */
	public concept DefinedConceptGR extends ConceptGR {

		DiagramShape containerShape with ShapeRole(metamodelElement=DC_CONTAINER);
		DiagramShape enumIcon with ShapeRole(metamodelElement=DC_ENUM_ICON, containerElement=containerShape,
				label=(modelConcept.isEnumeration ? "" : "X"), transparency=(modelConcept.isEnumeration ? 1.0 : 0.5));
		DiagramShape label with ShapeRole(metamodelElement=DC_LABEL, containerElement=containerShape, exampleLabel="DefConcept",
				label=modelConcept.name);
		DiagramShape attributes with ShapeRole(metamodelElement=DC_ATTRIBUTES, containerElement=containerShape);
		DiagramShape varIcon with ShapeRole(metamodelElement=DC_VAR_ICON, containerElement=containerShape,
				label=(modelConcept.isVariable ? "" : "X"), transparency=(modelConcept.isVariable ? 1.0 : 0.5));
		DiagramShape icon with ShapeRole(metamodelElement=DC_ICON, containerElement=containerShape);
		DefinedConcept modelConcept with ConceptInstance(virtualModelInstance=container.domainModel);
		LogicalFormulaGR logicalFormulaGR with ConceptInstance(virtualModelInstance=container);

		dropDefinedConceptGRAtTopLevel(String name, String logicalFormula, boolean isVariable, boolean isEnumeration)
				with DropScheme(targetType=DomainModelDiagram) {
			containerShape = DIAGRAM::AddShape(container=container.diagram) in (container.diagram);
			enumIcon = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			label = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			attributes = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			varIcon = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			icon = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			LogicalFormula formula = container.domainModel.new LogicalFormula(parameters.logicalFormula);
			modelConcept = container.domainModel.new DefinedConcept(parameters.name, parameters.isVariable, parameters.isEnumeration,
					null, formula);
			logicalFormulaGR = container.new LogicalFormulaGR(formula, container.logicalFormulaPane);
		}

		representDefinedConceptGRAtTopLevel(DefinedConcept aConcept) with DropScheme(targetType=DomainModelDiagram) {
			containerShape = DIAGRAM::AddShape(container=container.diagram) in (container.diagram);
			enumIcon = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			label = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			attributes = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			varIcon = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			icon = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			modelConcept = parameters.aConcept;
			this.representAdditionnalConceptLinks();
		}

		public delete() {
			for (IndividualOfGR item : select IndividualOfGR from container where (selected.conceptGR == this)) {
				delete item;
			}
			for (AssociationLeftArrowGR item : select AssociationLeftArrowGR from container where (selected.conceptGR == this)) {
				delete item;
			}
			for (AssociationRightArrowGR item : select AssociationRightArrowGR from container where (selected.conceptGR == this)) {
				delete item;
			}
			for (ParentConceptGR item : select ParentConceptGR from container
					where (selected.childConceptGR == this || selected.parentConceptGR == this)) {
				delete item;
			}
			for (ConceptAttributeGR item : select ConceptAttributeGR from container where (selected.conceptGR == this)) {
				delete item;
			}
			delete containerShape;
			delete enumIcon;
			delete label;
			delete icon;
			delete attributes;
			delete varIcon;
			delete logicalFormulaGR;
			delete modelConcept;
		}

		public delete::deleteView() {
			for (IndividualOfGR item : select IndividualOfGR from container where (selected.conceptGR == this)) {
				item.deleteView();
			}
			for (AssociationLeftArrowGR item : select AssociationLeftArrowGR from container where (selected.conceptGR == this)) {
				item.deleteView();
			}
			for (AssociationRightArrowGR item : select AssociationRightArrowGR from container where (selected.conceptGR == this)) {
				item.deleteView();
			}
			for (ParentConceptGR item : select ParentConceptGR from container
					where (selected.childConceptGR == this || selected.parentConceptGR == this)) {
				item.deleteView();
			}
			for (ConceptAttributeGR item : select ConceptAttributeGR from container where (selected.conceptGR == this)) {
				item.deleteView();
			}
			delete containerShape;
			delete enumIcon;
			delete label;
			delete icon;
			delete attributes;
			delete varIcon;
			modelConcept = null;
			logicalFormulaGR = null;
		}
	}

	/** An individual: a box with a label, a variable marker, and the values of its attributes */
	public concept IndividualGR {

		DiagramShape individualShape with ShapeRole(metamodelElement=I_SHAPE);
		DiagramShape icon with ShapeRole(metamodelElement=I_ICON, containerElement=individualShape);
		DiagramShape label with ShapeRole(metamodelElement=I_LABEL, containerElement=individualShape, exampleLabel="Individual",
				label=individual.name);
		DiagramShape attributeValues with ShapeRole(metamodelElement=I_ATTRIBUTE_VALUES, containerElement=individualShape);
		DiagramShape varIcon with ShapeRole(metamodelElement=I_VAR_ICON, containerElement=individualShape,
				label=(individual.isVariable ? "" : "X"), transparency=(individual.isVariable ? 1.0 : 0.5));
		Individual individual with ConceptInstance(virtualModelInstance=container.domainModel);

		/** True when the individual belongs to another domain model than the one this diagram presents */
		boolean isView {
			boolean get() {
				return container.domainModel != individual.container;
			}
		};

		dropIndividualGRAtTopLevel(String individualName, boolean isVariable) with DropScheme(targetType=DomainModelDiagram) {
			individualShape = DIAGRAM::AddShape(container=container.diagram) in (container.diagram);
			icon = DIAGRAM::AddShape(container=individualShape) in (container.diagram);
			label = DIAGRAM::AddShape(container=individualShape) in (container.diagram);
			attributeValues = DIAGRAM::AddShape(container=individualShape) in (container.diagram);
			varIcon = DIAGRAM::AddShape(container=individualShape) in (container.diagram);
			individual = container.domainModel.new Individual(parameters.individualName, null, parameters.isVariable, null);
		}

		representIndividualGRAtTopLevel(Individual individual) with DropScheme(targetType=DomainModelDiagram) {
			individualShape = DIAGRAM::AddShape(container=container.diagram) in (container.diagram);
			icon = DIAGRAM::AddShape(container=individualShape) in (container.diagram);
			label = DIAGRAM::AddShape(container=individualShape) in (container.diagram);
			attributeValues = DIAGRAM::AddShape(container=individualShape) in (container.diagram);
			varIcon = DIAGRAM::AddShape(container=individualShape) in (container.diagram);
			individual = parameters.individual;
			this.representAdditionnalIndividualLinks();
		}

		create(Individual aIndividual, DomainModelDiagram aDiagram) {
			individual = parameters.aIndividual;
			individualShape = DIAGRAM::AddShape(container=parameters.aDiagram.diagram) in (parameters.aDiagram.diagram);
			icon = DIAGRAM::AddShape(container=individualShape) in (parameters.aDiagram.diagram);
			label = DIAGRAM::AddShape(container=individualShape) in (parameters.aDiagram.diagram);
			attributeValues = DIAGRAM::AddShape(container=individualShape) in (parameters.aDiagram.diagram);
			varIcon = DIAGRAM::AddShape(container=individualShape) in (parameters.aDiagram.diagram);
			if (individual.individualOf != null) {
				ConceptGR conceptGR = select unique ConceptGR from parameters.aDiagram
						where (selected.modelConcept == individual.individualOf);
				if (conceptGR != null) {
					container.new IndividualOfGR(this, conceptGR);
				}
			}
		}

		public delete() {
			delete individualShape;
			delete icon;
			delete label;
			delete attributeValues;
			delete varIcon;
			for (IndividualAttributeGR item : select IndividualAttributeGR from container where (selected.individualGR == this)) {
				delete item;
			}
			for (IndividualOfGR item : select IndividualOfGR from container where (selected.individualGR == this)) {
				delete item;
			}
			for (InitialValueGR item : select InitialValueGR from container
					where (selected.fromIndividualGR == this || selected.toIndividualGR == this)) {
				delete item;
			}
			for (MapletIndividualAntecedentGR item : select MapletIndividualAntecedentGR from container
					where (selected.individualGR == this)) {
				delete item;
			}
			for (MapletIndividualImageGR item : select MapletIndividualImageGR from container where (selected.individualGR == this)) {
				delete item;
			}
			for (SimpleMapletIndividualGR item : select SimpleMapletIndividualGR from container
					where (selected.fromIndividualGR == this || selected.toIndividualGR == this)) {
				delete item;
			}
			delete individual;
		}

		public delete::deleteView() {
			delete individualShape;
			delete icon;
			delete label;
			delete attributeValues;
			delete varIcon;
			for (IndividualAttributeGR item : select IndividualAttributeGR from container where (selected.individualGR == this)) {
				item.deleteView();
			}
			for (IndividualOfGR item : select IndividualOfGR from container where (selected.individualGR == this)) {
				item.deleteView();
			}
			for (InitialValueGR item : select InitialValueGR from container
					where (selected.fromIndividualGR == this || selected.toIndividualGR == this)) {
				item.deleteView();
			}
			for (MapletIndividualAntecedentGR item : select MapletIndividualAntecedentGR from container
					where (selected.individualGR == this)) {
				item.deleteView();
			}
			for (MapletIndividualImageGR item : select MapletIndividualImageGR from container where (selected.individualGR == this)) {
				item.deleteView();
			}
			for (SimpleMapletIndividualGR item : select SimpleMapletIndividualGR from container
					where (selected.fromIndividualGR == this || selected.toIndividualGR == this)) {
				item.deleteView();
			}
			individual = null;
		}

		/** Lay the attribute values out, one line each */
		public refreshIndividual() {
			int counter = 0;
			for (DiagramShape item : attributeValues.shapes) {
				item.graphicalRepresentation.y = counter * 20;
				counter = counter + 1;
			}
		}

		/** Draw the links between this individual and the concepts, individuals and maplets the diagram already shows */
		public representAdditionnalIndividualLinks() {
			if (individual.individualOf != null) {
				ConceptGR conceptGR = select unique ConceptGR from container where (selected.modelConcept == individual.individualOf);
				if (conceptGR != null) {
					container.new IndividualOfGR(this, conceptGR);
				}
			}
			if (individual.initialValue != null) {
				IndividualGR initialValueGR = select unique IndividualGR from container
						where (selected.individual == individual.initialValue);
				if (initialValueGR != null) {
					container.new InitialValueGR(this, initialValueGR);
				}
			}
			for (IndividualGR iGR : select IndividualGR from container where (selected.individual.initialValue == individual)) {
				container.new InitialValueGR(iGR, this);
			}
			for (MapletIndividualGR miGR : select MapletIndividualGR from container
					where (selected.individual.antecedent == individual || selected.individual.image == individual)) {
				if (miGR.individual.antecedent == individual) {
					container.new MapletIndividualAntecedentGR(this, miGR);
				}
				if (miGR.individual.image == individual) {
					container.new MapletIndividualImageGR(this, miGR);
				}
			}
		}
	}

	/** The connector from an individual to the concept it is an individual of */
	public concept IndividualOfGR {

		DiagramConnector connector with ConnectorRole(metamodelElement=INDIVIDUAL_OF_CONNECTOR);
		IndividualGR individualGR with ConceptInstance(virtualModelInstance=container);
		ConceptGR conceptGR with ConceptInstance(virtualModelInstance=container);

		boolean isView {
			boolean get() {
				return container.domainModel != individualGR.individual.container
						&& container.domainModel != conceptGR.modelConcept.container;
			}
		};

		linkIndividualGRToConceptGR() with LinkScheme(fromType=IndividualGR, toType=ConceptGR) {
			connector = DIAGRAM::AddConnector(fromShape=fromTarget.individualShape, toShape=toTarget.containerShape)
					in (container.diagram);
			individualGR = fromTarget;
			conceptGR = toTarget;
			individualGR.individual.individualOf = conceptGR.modelConcept;
			notify "sole_individuals" in container.domainModel;
			notify "concepts" in container.domainModel;
		}

		create(IndividualGR fromGR, ConceptGR toGR) {
			individualGR = parameters.fromGR;
			conceptGR = parameters.toGR;
			connector = DIAGRAM::AddConnector(fromShape=individualGR.individualShape, toShape=conceptGR.containerShape)
					in (container.diagram);
			notify "sole_individuals" in container.domainModel;
			notify "concepts" in container.domainModel;
		}

		public delete() {
			delete connector;
			individualGR.individual.individualOf = null;
			individualGR = null;
			conceptGR = null;
			notify "sole_individuals" in container.domainModel;
			notify "concepts" in container.domainModel;
		}

		public delete::deleteView() {
			delete connector;
			individualGR = null;
			conceptGR = null;
		}
	}

	/** An association between two concepts: a box between them, with a connector to each */
	public concept AssociationGR extends ConceptGR {

		DiagramShape containerShape with ShapeRole(metamodelElement=A_CONTAINER, label="");
		DiagramShape enumIcon with ShapeRole(metamodelElement=A_ENUM_ICON, containerElement=containerShape,
				label=(modelConcept.isEnumeration ? "" : "X"), transparency=(modelConcept.isEnumeration ? 1.0 : 0.5));
		DiagramShape label with ShapeRole(metamodelElement=A_LABEL, containerElement=containerShape, exampleLabel="Association",
				label=modelConcept.name);
		DiagramShape attributes with ShapeRole(metamodelElement=A_ATTRIBUTES, containerElement=containerShape);
		DiagramShape varIcon with ShapeRole(metamodelElement=A_VAR_ICON, containerElement=containerShape,
				label=(modelConcept.isVariable ? "" : "X"), transparency=(modelConcept.isVariable ? 1.0 : 0.5));
		DiagramShape icon with ShapeRole(metamodelElement=A_ICON, containerElement=containerShape);
		Association modelConcept with ConceptInstance(virtualModelInstance=container.domainModel);
		AssociationLeftArrowGR associationLeftArrowGR with ConceptInstance(virtualModelInstance=container);
		AssociationRightArrowGR associationRightArrowGR with ConceptInstance(virtualModelInstance=container);

		dropAssociationGRAtTopLevel(String name, boolean isVariable, boolean isEnumeration)
				with DropScheme(targetType=DomainModelDiagram) {
			containerShape = DIAGRAM::AddShape(container=container.diagram) in (container.diagram);
			enumIcon = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			label = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			attributes = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			varIcon = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			icon = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			Cardinality domainCardinality = container.domainModel.new Cardinality("0..*");
			Cardinality rangeCardinality = container.domainModel.new Cardinality("0..*");
			modelConcept = container.domainModel.new Association(parameters.name, parameters.isVariable, parameters.isEnumeration, null,
					null, null, domainCardinality, rangeCardinality, false, false, false, false, false);
		}

		createAssociation(String name, boolean isVariable, boolean isEnumeration) with LinkScheme(fromType=ConceptGR, toType=ConceptGR) {
			Cardinality domainCardinality = container.domainModel.new Cardinality("0..*");
			Cardinality rangeCardinality = container.domainModel.new Cardinality("0..*");
			modelConcept = container.domainModel.new Association(parameters.name, parameters.isVariable, parameters.isEnumeration, null,
					fromTarget.modelConcept, toTarget.modelConcept, domainCardinality, rangeCardinality, false, false, false, false, false);
			containerShape = DIAGRAM::AddShape(container=container.diagram) in (container.diagram);
			enumIcon = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			label = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			attributes = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			varIcon = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			icon = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			associationRightArrowGR = container.new AssociationRightArrowGR(toTarget, this);
			associationLeftArrowGR = container.new AssociationLeftArrowGR(fromTarget, this);
			// Lay the association out halfway between the two concepts
			DIAGRAM::GraphicalAction(subject=containerShape, graphicalFeatureName="x",
					value=((fromTarget.containerShape.graphicalRepresentation.x + fromTarget.containerShape.graphicalRepresentation.width / 2
							+ toTarget.containerShape.graphicalRepresentation.x + toTarget.containerShape.graphicalRepresentation.width / 2) / 2
							- containerShape.graphicalRepresentation.width / 2)) in (container.diagram);
			DIAGRAM::GraphicalAction(subject=containerShape, graphicalFeatureName="y",
					value=((fromTarget.containerShape.graphicalRepresentation.y + fromTarget.containerShape.graphicalRepresentation.height / 2
							+ toTarget.containerShape.graphicalRepresentation.y + toTarget.containerShape.graphicalRepresentation.height / 2) / 2
							- containerShape.graphicalRepresentation.height / 2)) in (container.diagram);
		}

		representAssociationGRAtTopLevel(Association association) with DropScheme(targetType=DomainModelDiagram) {
			containerShape = DIAGRAM::AddShape(container=container.diagram) in (container.diagram);
			enumIcon = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			label = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			attributes = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			varIcon = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			icon = DIAGRAM::AddShape(container=containerShape) in (container.diagram);
			modelConcept = parameters.association;
			if (modelConcept.domain != null) {
				ConceptGR domainGR = select unique ConceptGR from container where (selected.modelConcept == modelConcept.domain);
				if (domainGR != null) {
					associationLeftArrowGR = container.new AssociationLeftArrowGR(domainGR, this);
				}
			}
			if (modelConcept.range != null) {
				ConceptGR rangeGR = select unique ConceptGR from container where (selected.modelConcept == modelConcept.range);
				if (rangeGR != null) {
					associationRightArrowGR = container.new AssociationRightArrowGR(rangeGR, this);
				}
			}
			this.representAdditionnalConceptLinks();
		}

		public delete() {
			if (associationRightArrowGR != null) {
				delete associationRightArrowGR;
			}
			if (associationLeftArrowGR != null) {
				delete associationLeftArrowGR;
			}
			for (IndividualOfGR item : select IndividualOfGR from container where (selected.conceptGR == this)) {
				delete item;
			}
			for (AssociationLeftArrowGR item : select AssociationLeftArrowGR from container where (selected.conceptGR == this)) {
				delete item;
			}
			for (AssociationRightArrowGR item : select AssociationRightArrowGR from container where (selected.conceptGR == this)) {
				delete item;
			}
			for (ParentConceptGR item : select ParentConceptGR from container
					where (selected.childConceptGR == this || selected.parentConceptGR == this)) {
				delete item;
			}
			for (ConceptAttributeGR item : select ConceptAttributeGR from container where (selected.conceptGR == this)) {
				delete item;
			}
			delete containerShape;
			delete enumIcon;
			delete label;
			delete icon;
			delete attributes;
			delete varIcon;
			delete modelConcept;
		}

		public delete::deleteView() {
			for (IndividualOfGR item : select IndividualOfGR from container where (selected.conceptGR == this)) {
				item.deleteView();
			}
			for (AssociationLeftArrowGR item : select AssociationLeftArrowGR from container where (selected.conceptGR == this)) {
				item.deleteView();
			}
			for (AssociationRightArrowGR item : select AssociationRightArrowGR from container where (selected.conceptGR == this)) {
				item.deleteView();
			}
			for (ParentConceptGR item : select ParentConceptGR from container
					where (selected.childConceptGR == this || selected.parentConceptGR == this)) {
				item.deleteView();
			}
			for (ConceptAttributeGR item : select ConceptAttributeGR from container where (selected.conceptGR == this)) {
				item.deleteView();
			}
			delete containerShape;
			delete enumIcon;
			delete label;
			delete icon;
			delete attributes;
			delete varIcon;
			modelConcept = null;
			associationLeftArrowGR = null;
			associationRightArrowGR = null;
		}
	}

	/** The connector from the domain concept of an association to the association, labelled with the domain cardinality */
	public concept AssociationLeftArrowGR {

		DiagramConnector cardinalityShapeLeft with ConnectorRole(metamodelElement=ASSOCIATION_LEFT_CONNECTOR,
				label=associationGR.modelConcept.domainCardinality.cardinality);
		ConceptGR conceptGR with ConceptInstance(virtualModelInstance=container);
		AssociationGR associationGR with ConceptInstance(virtualModelInstance=container);

		boolean isView {
			boolean get() {
				return container.domainModel != associationGR.modelConcept.container
						&& container.domainModel != conceptGR.modelConcept.container;
			}
		};

		linkConceptGRToAssociationGR() with LinkScheme(fromType=ConceptGR, toType=AssociationGR) {
			conceptGR = fromTarget;
			associationGR = toTarget;
			cardinalityShapeLeft = DIAGRAM::AddConnector(fromShape=conceptGR.containerShape, toShape=associationGR.containerShape)
					in (container.diagram);
			associationGR.modelConcept.domain = fromTarget.modelConcept;
			associationGR.associationLeftArrowGR = this;
		}

		create(ConceptGR conceptGR, AssociationGR assocationGR) {
			conceptGR = parameters.conceptGR;
			associationGR = parameters.assocationGR;
			cardinalityShapeLeft = DIAGRAM::AddConnector(fromShape=conceptGR.containerShape, toShape=associationGR.containerShape)
					in (container.diagram);
		}

		public delete() {
			delete cardinalityShapeLeft;
			associationGR.modelConcept.domain = null;
			conceptGR = null;
			associationGR = null;
		}

		public delete::deleteView() {
			delete cardinalityShapeLeft;
			conceptGR = null;
			associationGR = null;
		}
	}

