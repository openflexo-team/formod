<?xml version="1.0" encoding="UTF-8"?>
<!-- Inspector of IndividualGR, rebuilt from the Inspector of its legacy .fml.xml serialization. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="IndividualGRInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FlexoConceptInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<TabPanel name="Tab">
		<Tab title="Individual" layout="twocols" index="0" name="IndividualGRInspectorTab">
			<Label label="name" name="nameLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=1)" />
			<TextField data="data.individual.name" name="nameTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=1)" />
			<Label label="isVariable" name="isVariableLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=2)" />
			<CheckBox data="data.individual.isVariable" name="isVariableCheckBox" constraints="twocols(expandHorizontally=false;expandVertically=false;location=right;index=2)" />
			<Label label="individual of" name="individualOfLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=3)" />
			<TextField data="data.individual.individualOf.name" readOnly="true" name="individualOfTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=3)" />
			<Label label="initial value" name="initialValueLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=4)" />
			<TextField data="data.individual.initialValue.name" readOnly="true" name="initialValueTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=4)" />
		</Tab>
	</TabPanel>
</Panel>
