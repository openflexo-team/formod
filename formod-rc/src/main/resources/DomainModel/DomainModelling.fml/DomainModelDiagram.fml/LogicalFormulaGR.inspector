<?xml version="1.0" encoding="UTF-8"?>
<!-- Inspector of LogicalFormulaGR, rebuilt from the Inspector of its legacy .fml.xml serialization. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="LogicalFormulaGRInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FlexoConceptInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<TabPanel name="Tab">
		<Tab title="Logical Formula" layout="twocols" index="0" name="LogicalFormulaGRInspectorTab">
			<Label label="assertion" name="assertionLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=1)" />
			<TextArea data="data.logicalFormula.assertion" validateOnReturn="true" useScrollBar="true" name="assertionTextArea" constraints="twocols(expandHorizontally=true;expandVertically=true;location=right;index=1)" />
		</Tab>
	</TabPanel>
</Panel>
