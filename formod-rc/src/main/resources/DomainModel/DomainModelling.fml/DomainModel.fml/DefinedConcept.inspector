<?xml version="1.0" encoding="UTF-8"?>
<!-- Inspector of DefinedConcept, rebuilt from the Inspector of its legacy .fml.xml serialization. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="DefinedConceptInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FlexoConceptInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<Label label="Defined with" name="definedWithLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=101)" />
	<TextArea data="data.definedWith.get(0).assertion" validateOnReturn="true" useScrollBar="true" name="definedWithTextArea" constraints="twocols(expandHorizontally=true;expandVertically=true;location=right;index=101)" />
</Panel>
