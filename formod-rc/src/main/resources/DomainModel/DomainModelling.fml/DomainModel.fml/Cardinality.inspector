<?xml version="1.0" encoding="UTF-8"?>
<!-- Inspector of Cardinality, rebuilt from the Inspector of its legacy .fml.xml serialization. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="CardinalityInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FlexoConceptInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<Label label="cardinality" name="cardinalityLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=1)" />
	<TextField data="data.cardinality" name="cardinalityTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=1)" />
</Panel>
