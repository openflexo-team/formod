<?xml version="1.0" encoding="UTF-8"?>
<!-- Inspector of MapletIndividual, rebuilt from the Inspector of its legacy .fml.xml serialization. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="MapletIndividualInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FlexoConceptInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<Label label="antecedent" name="antecedentLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=101)" />
	<TextField data="data.antecedent.name" readOnly="true" name="antecedentTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=101)" />
	<Label label="image" name="imageLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=102)" />
	<TextField data="data.image.name" readOnly="true" name="imageTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=102)" />
</Panel>
