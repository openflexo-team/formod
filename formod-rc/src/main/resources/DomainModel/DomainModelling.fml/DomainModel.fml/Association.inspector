<?xml version="1.0" encoding="UTF-8"?>
<!-- Inspector of Association, rebuilt from the Inspector of its legacy .fml.xml serialization. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="AssociationInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FlexoConceptInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<TabPanel name="Tab">
		<Tab title="Association" layout="twocols" index="0" name="AssociationInspectorTab">
			<Label label="domain" name="domainLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=101)" />
			<TextField data="data.domain.name" readOnly="true" name="domainTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=101)" />
			<Label label="range" name="rangeLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=102)" />
			<TextField data="data.range.name" readOnly="true" name="rangeTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=102)" />
			<Label label="domainCardinality" name="domainCardinalityLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=103)" />
			<TextField data="data.domainCardinality.cardinality" name="domainCardinalityTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=103)" />
			<Label label="rangeCardinality" name="rangeCardinalityLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=104)" />
			<TextField data="data.rangeCardinality.cardinality" name="rangeCardinalityTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=104)" />
			<Label label="isTransitive" name="isTransitiveLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=105)" />
			<CheckBox data="data.isTransitive" name="isTransitiveCheckBox" constraints="twocols(expandHorizontally=false;expandVertically=false;location=right;index=105)" />
			<Label label="isSysmmetric" name="isSysmmetricLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=106)" />
			<CheckBox data="data.isSysmmetric" name="isSysmmetricCheckBox" constraints="twocols(expandHorizontally=false;expandVertically=false;location=right;index=106)" />
			<Label label="isASymmetric" name="isASymmetricLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=107)" />
			<CheckBox data="data.isASymmetric" name="isASymmetricCheckBox" constraints="twocols(expandHorizontally=false;expandVertically=false;location=right;index=107)" />
			<Label label="isReflexive" name="isReflexiveLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=108)" />
			<CheckBox data="data.isReflexive" name="isReflexiveCheckBox" constraints="twocols(expandHorizontally=false;expandVertically=false;location=right;index=108)" />
			<Label label="isIrreflexive" name="isIrreflexiveLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=109)" />
			<CheckBox data="data.isIrreflexive" name="isIrreflexiveCheckBox" constraints="twocols(expandHorizontally=false;expandVertically=false;location=right;index=109)" />
		</Tab>
	</TabPanel>
</Panel>
