/**
 * A domain model: the concepts of a domain (plain, defined by a logical formula, associations between concepts, default data
 * types) and the individuals populating them. Domain models form a tree: each one refines its parent, down from the root domain
 * model the DomainModelling container creates with the default data types.
 *
 * Migrated from the legacy DomainModel.fml.xml serialization (formod 2.1). Its URI follows the 2.99 convention (resource center
 * base URI + relative path): http://formose.lacl.fr/DomainModel/DomainModelling.fml/DomainModel.fml, no longer
 * ".../resources/DomainModel/...".
 *
 * The legacy names are kept, misspellings included (isSysmmetric, sole_individuals), because the .fib components of the Formose
 * module read them. The legacy get/set properties (concepts, sole_individuals, isSole) are computed properties here, so that the
 * components keep reading them without parentheses.
 *
 * Deliberate divergences from the legacy model:
 * - the parameter "concept" of Individual.create, Individual.creationAction and MapletIndividual.create became aConcept: "concept"
 *   is a keyword in 2.99;
 * - the renderers of DefinedConcept, Association and MapletIndividual read this.concept, a property none of them has: they are
 *   dropped, and these concepts render with the name their parent concept renders;
 * - conceptIndividuals also stops when a domain model has no parent: the legacy loop only stopped on the root domain model, and
 *   looped forever from a model outside the tree;
 * - the legacy used "&" (bitwise) where it meant a boolean and: written && here;
 * - Cardinality reads the whole string with cardinality itself, and its tail with the one-argument substring, where the legacy
 *   wrote substring(..., cardinality.length);
 * - inspectors and icons are gone: FlexoConceptInspector is deprecated in 2.99; the icons follow in the user interface step.
 *
 * @version 0.1
 */

use org.openflexo.foundation.fml.rt.FMLRTModelSlot as FMLRT;

import java.util.List;
import java.util.ArrayList;

@URI("http://formose.lacl.fr/DomainModel/DomainModelling.fml/DomainModel.fml")
@Version("0.1")
@Renderer("modelName")
public model DomainModel {

	String[1,1] modelName;

	/** The domain model this one refines, null for the root domain model */
	DomainModel parentDomainModel with ModelInstance();

	/** All concepts declared in this domain model */
	List<Concept> concepts {
		List<Concept> get() {
			return select Concept from this;
		}
	};

	/** Individuals of this model whose concept is declared in another domain model */
	List<Individual> sole_individuals {
		List<Individual> get() {
			return select Individual from this where (selected.isSole);
		}
	};

	create(String name, DomainModel parent) {
		modelName = parameters.name;
		parentDomainModel = parameters.parent;
	}

	delete() {
		modelName = null;
	}

	/** The individuals of supplied concept, in this domain model and in every domain model it refines */
	public List<Individual> conceptIndividuals(Concept aConcept) {
		DomainModel dm = this;
		List<Individual> list = new ArrayList();
		List<Individual> individuals = select Individual from dm
				where (!selected.isSole && selected.individualOf == parameters.aConcept);
		list.addAll(individuals);
		while (dm != container.rootDomainModel && dm.parentDomainModel != null) {
			dm = dm.parentDomainModel;
			individuals = select Individual from dm where (!selected.isSole && selected.individualOf == parameters.aConcept);
			list.addAll(individuals);
		}
		return list;
	}

	/** A set of individuals that share common characteristics */
	@Renderer("name")
	public concept Concept {

		String[1,1] name;
		boolean isVariable;
		boolean isEnumeration;
		Concept parentConcept with ConceptInstance(virtualModelInstance=container);

		create(String aName, boolean anIsVariable, boolean anIsEnumeration, Concept aParentConcept) {
			this.creationAction(parameters.aName, parameters.anIsVariable, parameters.anIsEnumeration, parameters.aParentConcept);
		}

		delete() {
			notify "concepts" in container;
		}

		public addIndividual(String name, boolean isVariable, Individual initialValue) {
		}

		public creationAction(String name, boolean isVariable, boolean isEnumeration, Concept parentConcept) {
			name = parameters.name;
			isVariable = parameters.isVariable;
			isEnumeration = parameters.isEnumeration;
			parentConcept = parameters.parentConcept;
			notify "concepts" in container;
		}
	}

	public concept DefaultDataType extends Concept {

		delete() {
			notify "concepts" in container;
		}

		create(String aName, boolean isEnumeration) {
			this.creationAction(parameters.aName, false, parameters.isEnumeration, null);
		}
	}

	public concept DefinedConcept extends Concept {

		LogicalFormula[1,*] definedWith with ConceptInstance(virtualModelInstance=container);

		delete() {
			for (LogicalFormula item : definedWith) {
				delete item;
			}
			notify "concepts" in container;
		}

		create(String aName, boolean anIsVariable, boolean anIsEnumeration, Concept aParentConcept, LogicalFormula definedWith) {
			this.creationAction(parameters.aName, parameters.anIsVariable, parameters.anIsEnumeration, parameters.aParentConcept);
			definedWith.add(parameters.definedWith);
		}
	}

	public concept Association extends Concept {

		boolean isTransitive;
		boolean isSysmmetric;
		boolean isASymmetric;
		boolean isReflexive;
		boolean isIrreflexive;
		Concept domain with ConceptInstance(virtualModelInstance=container);
		Concept range with ConceptInstance(virtualModelInstance=container);
		Cardinality domainCardinality with ConceptInstance(virtualModelInstance=container);
		Cardinality rangeCardinality with ConceptInstance(virtualModelInstance=container);

		create(String aName, boolean isVariable, boolean isEnumeration, Concept parentConcept, Concept aDomain, Concept aRange,
				Cardinality domainCardinality, Cardinality rangeCardinality, boolean anIsTransitive, boolean anIsSysmmetric,
				boolean anIsASymmetric, boolean anIsReflexive, boolean anIsIrreflexive) {
			isTransitive = parameters.anIsTransitive;
			isSysmmetric = parameters.anIsSysmmetric;
			isASymmetric = parameters.anIsASymmetric;
			isReflexive = parameters.anIsReflexive;
			isIrreflexive = parameters.anIsIrreflexive;
			domain = parameters.aDomain;
			range = parameters.aRange;
			domainCardinality = parameters.domainCardinality;
			rangeCardinality = parameters.rangeCardinality;
			this.creationAction(parameters.aName, parameters.isVariable, parameters.isEnumeration, parameters.parentConcept);
		}

		delete() {
			delete domainCardinality;
			delete rangeCardinality;
			notify "concepts" in container;
		}
	}

	/**
	 * A cardinality, written "n", "n..m" or "n..*"
	 *
	 * Legacy validity note: cardinality.matches("(([0-9]+)\\.\\.([0-9]+))") ? (lower bound <= upper bound) : true
	 */
	@Renderer("cardinality")
	public concept Cardinality {

		String[1,1] cardinality = "0..*";

		create(String cardinality) {
			cardinality = parameters.cardinality;
		}

		delete() {
		}

		public String getMinCardinality() {
			if (cardinality.contains("..")) {
				return cardinality.substring(0, cardinality.indexOf(".."));
			}
			return cardinality;
		}

		/** The upper bound, "-1" when unbounded */
		public String getMaxCardinality() {
			if (cardinality.contains("..")) {
				if (cardinality.contains("*")) {
					return "-1";
				}
				return cardinality.substring(cardinality.indexOf("..") + 2);
			}
			return cardinality;
		}
	}

	/** Items of the world */
	@Renderer("name")
	public concept Individual {

		String name;
		boolean isVariable;
		Individual initialValue with ConceptInstance(virtualModelInstance=container);
		Concept individualOf with ConceptInstance(virtualModelInstance=container);

		/** True when the concept of this individual is declared in another domain model */
		boolean isSole {
			boolean get() {
				if (individualOf == null) {
					return true;
				}
				return individualOf.container != container;
			}
		};

		create(String aName, Concept aConcept, boolean anIsVariable, Individual initialValue) {
			this.creationAction(parameters.aName, parameters.aConcept, parameters.anIsVariable, parameters.initialValue);
		}

		delete() {
			notify "concepts" in container;
			notify "sole_individuals" in container;
		}

		public creationAction(String name, Concept aConcept, boolean isVariable, Individual initialValue) {
			name = parameters.name;
			isVariable = parameters.isVariable;
			initialValue = parameters.initialValue;
			individualOf = parameters.aConcept;
			notify "sole_individuals" in container;
			notify "concepts" in container;
		}

		public String getCanonicalString() {
			return name;
		}
	}

	/** An individual of an association: the pair (antecedent, image) */
	public concept MapletIndividual extends Individual {

		Individual antecedent with ConceptInstance(virtualModelInstance=container);
		Individual image with ConceptInstance(virtualModelInstance=container);

		/** A maplet is an individual of an association, whose range gives the type of its image */
		Association individualOf with ConceptInstance(virtualModelInstance=container);

		delete() {
			notify "concepts" in container;
			notify "sole_individuals" in container;
		}

		create(String aName, Association aConcept, Individual antecedent, Individual image, boolean anIsVariable,
				Individual initialValue) {
			this.creationAction(parameters.aName, parameters.aConcept, parameters.anIsVariable, parameters.initialValue);
			antecedent = parameters.antecedent;
			image = parameters.image;
		}

		public String getCanonicalString() {
			if (name == null) {
				return antecedent.name + " |-> " + image.name;
			}
			return name;
		}

		public String getNormalisedString() {
			return antecedent.name + "_" + image.name;
		}
	}

	public concept LogicalFormula {

		String[1,1] assertion;
		Concept[0,*] concepts with ConceptInstance(virtualModelInstance=container);
		Individual[0,*] individuals with ConceptInstance(virtualModelInstance=container);
		QuantVariable[0,*] variables with ConceptInstance(virtualModelInstance=container);

		create(String anAssertion) {
			assertion = parameters.anAssertion;
		}

		delete() {
			for (QuantVariable item : variables) {
				delete item;
			}
		}
	}

	@Renderer("name")
	public concept QuantVariable {

		String[1,1] name;

		create(String aName) {
			name = parameters.aName;
		}

		delete() {
		}
	}

	enum DefaultDataTypeEnum {
		NATURAL,
		INTEGER,
		FLOAT,
		STRING,
		BOOL
	}
}
