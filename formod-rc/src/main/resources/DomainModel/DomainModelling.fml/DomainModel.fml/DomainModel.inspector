<?xml version="1.0" encoding="UTF-8"?>
<!-- Inspector of DomainModel, rebuilt from the Inspector of its legacy .fml.xml serialization. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="DomainModelInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FMLRTVirtualModelInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<TabPanel name="Tab">
		<Tab title="DomainModel" layout="twocols" index="0" name="DomainModelInspectorTab">
			<Label label="modelName" name="modelNameLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=1)" />
			<TextField data="data.modelName" name="modelNameTextField" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=1)" />
			<Label label="parentDomainModel" name="parentDomainModelLabel" constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=2)" />
			<Custom componentClassName="org.openflexo.fml.rt.controller.widget.FIBVirtualModelInstanceSelector" dataClassForComponent="org.openflexo.foundation.fml.rt.FMLRTVirtualModelInstance" manageDynamicModel="true" data="data.parentDomainModel" name="parentDomainModelSelector" constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=2)">
				<Assignment variable="component.serviceManager" value="controller.flexoController.applicationContext" mandatory="true" />
			</Custom>
		</Tab>
	</TabPanel>
</Panel>
