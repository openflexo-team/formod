// CORE-F-11 phase 6 (FORMOD-F-5): addSetToNullComponent() fails with a typed FML error, no longer a warning and null.
virtualModel = load -r ["http://www.openflexo.org/test/b/FML/BErrorKinds.fml"];
service ResourceCenterService add_temp_rc;
vmi = new BErrorKinds() with (name="addSetToNullComponent");
mustFail = vmi.addSetToNullComponent();
